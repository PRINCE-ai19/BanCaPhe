<Window x:Class="BanCaPhe.VoucherModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Áp dụng mã giảm giá"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#E8F0E8"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search Box -->
            <RowDefinition Height="Auto"/> <!-- Customer Info -->
            <RowDefinition Height="*"/>    <!-- Voucher List -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D5F3F" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎁" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="Áp dụng mã giảm giá" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Customer Search Box -->
        <Border Grid.Row="1" Background="#FFFFFF" Padding="15" Margin="15,15,15,10" CornerRadius="8" BorderBrush="#D0E8DC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tìm kiếm khách hàng" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,8"/>
                <TextBox x:Name="SearchBox" 
                         Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="32" 
                         VerticalContentAlignment="Center" 
                         Padding="10,0" 
                         FontSize="11"
                         Background="#F1F8F4" 
                         BorderThickness="1" 
                         BorderBrush="#D0E8DC"
                         Tag="Nhập SĐT hoặc họ tên...">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}" 
                                                               Foreground="#A0A0A0" 
                                                               FontSize="11" 
                                                               Margin="10,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Customer Search Results -->
                <Border Visibility="{Binding HasCustomerResults, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,8,0,0" 
                        Background="#F1F8F4" 
                        CornerRadius="6" 
                        BorderBrush="#D0E8DC" 
                        BorderThickness="1"
                        MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CustomerSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Cursor="Hand" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D0E8DC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="11" Foreground="#1F4D3D"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding SoDienThoai}" FontSize="10" Foreground="#4A7C6B" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CapBac}" FontSize="10" Foreground="#2D7A5C" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- No Customer Found Message -->
                <TextBlock Text="Không tìm thấy khách hàng" 
                           Visibility="{Binding ShowNoCustomerMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="10" 
                           Foreground="#C62828" 
                           Margin="0,8,0,0" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Selected Customer Info -->
        <Border Grid.Row="2" 
                Background="#FFFFFF" 
                Padding="15" 
                Margin="15,0,15,10" 
                CornerRadius="8" 
                BorderBrush="#D0E8DC" 
                BorderThickness="1"
                Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Khách hàng đã chọn" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,8"/>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCustomer.HoTen}" FontWeight="Bold" FontSize="13" Foreground="#1F4D3D"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="📞 " FontSize="10"/>
                            <TextBlock Text="{Binding SelectedCustomer.SoDienThoai}" FontSize="10" Foreground="#4A7C6B" Margin="0,0,15,0"/>
                            <TextBlock Text="⭐ " FontSize="10"/>
                            <TextBlock Text="{Binding SelectedCustomer.CapBac}" FontSize="10" Foreground="#2D7A5C" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Voucher List -->
        <Border Grid.Row="3" 
                Background="#FFFFFF" 
                Padding="15" 
                Margin="15,0,15,10" 
                CornerRadius="8" 
                BorderBrush="#D0E8DC" 
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Mã giảm giá khả dụng" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,10"/>

                <!-- Loading Indicator -->
                <TextBlock Text="Đang tải..." 
                           Visibility="{Binding IsLoadingVouchers, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="11" 
                           Foreground="#6B8B7E" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,0"/>

                <!-- Voucher List ScrollViewer -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              MaxHeight="280"
                              Visibility="{Binding HasVouchers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding AvailableVouchers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" 
                                        Margin="0,0,0,8" 
                                        Background="#F1F8F4" 
                                        CornerRadius="8" 
                                        BorderBrush="#D0E8DC" 
                                        BorderThickness="1"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#D0E8DC"/>
                                                    <Setter Property="BorderBrush" Value="#2D7A5C"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E0F2E9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.SelectVoucherCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Voucher Code -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Background="#2D7A5C" 
                                                    CornerRadius="4" 
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding MaVoucher}" 
                                                           FontWeight="Bold" 
                                                           FontSize="11" 
                                                           Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="✓" 
                                                       FontSize="14" 
                                                       Foreground="#2D7A5C" 
                                                       FontWeight="Bold" 
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Voucher Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding MoTa}" 
                                                   FontSize="10" 
                                                   Foreground="#1F4D3D" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,6,0,0"/>

                                        <!-- Voucher Details -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Giảm: " FontSize="9" Foreground="#6B8B7E"/>
                                            <TextBlock Text="{Binding GiaTriGiam}" 
                                                       FontSize="9" 
                                                       FontWeight="Bold" 
                                                       Foreground="#C62828" 
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Text="HSD: " FontSize="9" Foreground="#6B8B7E"/>
                                            <TextBlock Text="{Binding NgayHetHan, StringFormat=dd/MM/yyyy}" 
                                                       FontSize="9" 
                                                       Foreground="#6B8B7E"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- No Vouchers Message -->
                <TextBlock Text="Khách hàng không có mã giảm giá khả dụng" 
                           Visibility="{Binding ShowNoVouchersMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="11" 
                           Foreground="#6B8B7E" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,0"
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="4" Background="#FFFFFF" Padding="15" Margin="15,0,15,15" CornerRadius="8" BorderBrush="#D0E8DC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Đóng" 
                        Height="36" 
                        Background="#E0E0E0" 
                        Foreground="#424242" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" 
                        Content="Xác nhận" 
                        Height="36" 
                        Background="#2D7A5C" 
                        Foreground="#FFFFFF" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ApplyVoucherCommand}"
                        IsEnabled="{Binding HasSelectedVoucher}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A9B73"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#A0A0A0"/>
                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
