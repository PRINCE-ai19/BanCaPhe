<UserControl x:Class="BanCaPhe.W_LoaiSanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BanCaPhe"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel">

    <UserControl.DataContext>
        <vm:LoaiSanPhamViewModel/>
    </UserControl.DataContext>

    <Grid Margin="0" Background="#FAFAF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#2D5F3F" Padding="20,12,20,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📂 Quản lý danh mục"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DanhMucList.Count, StringFormat=({0} danh mục)}"
                               FontSize="12"
                               Foreground="#D0E8DC"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- ADD BUTTON -->
                <Button Grid.Column="1"
                        Content="+ Thêm danh mục"
                        Height="36"
                        Padding="16,8"
                        Background="#A8D5BA"
                        Foreground="#1F4D3D"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ThemCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- FORM NHẬP -->
        <Border Grid.Row="1"
                Padding="20"
                Background="#FFFFFF"
                BorderBrush="#D0E8DC"
                BorderThickness="0,0,0,1"
                Margin="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TÊN LOẠI -->
                <StackPanel>
                    <TextBlock Text="Tên loại" FontWeight="Bold" Foreground="#2D5F3F" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTenLoai"
                             Text="{Binding TenLoai, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="12,9"
                             FontSize="12"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#D0E8DC"
                             BorderThickness="1"
                             Margin="0,0,10,0"/>
                </StackPanel>

                <!-- VỊ TRÍ -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Vị trí" FontWeight="Bold" Foreground="#2D5F3F" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtViTri"
                             Text="{Binding ViTri, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="12,9"
                             FontSize="12"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#D0E8DC"
                             BorderThickness="1"/>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="20,0,0,0">

                    <Button Content="✎ Sửa"
                            Width="60"
                            Height="36"
                            Margin="0,0,4,0"
                            Background="#A8D5BA"
                            Foreground="#1F4D3D"
                            FontWeight="Bold"
                            FontSize="11"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SuaCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="✕ Xóa"
                            Width="60"
                            Height="36"
                            Background="#FFCDD2"
                            Foreground="#C62828"
                            FontWeight="Bold"
                            FontSize="11"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding XoaCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgLoaiDoUong"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="40"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhMucList}"
                  SelectedItem="{Binding SelectedDanhMuc}"
                  Background="#FFFFFF"
                  Foreground="#1F4D3D"
                  BorderBrush="#D0E8DC"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E8F0E8"
                  Margin="0">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8F0E8"/>
                    <Setter Property="Foreground" Value="#2D5F3F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderBrush" Value="#D0E8DC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên loại"
                                    Binding="{Binding TenLoai}"
                                    Width="*"/>

                <DataGridTextColumn Header="Vị trí"
                                    Binding="{Binding ViTri}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
