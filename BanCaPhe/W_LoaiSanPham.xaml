<UserControl x:Class="BanCaPhe.W_LoaiSanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TIÊU ĐỀ ── -->
        <TextBlock Text="Quản lý Danh Mục Đồ Uống"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,16"/>

        <!-- ── FORM NHẬP ── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16"
                Effect="{StaticResource LightShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tên loại -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Tên loại" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtTenLoai"
                             Style="{StaticResource ModtraTextBox}"/>
                </StackPanel>

                <!-- Vị trí -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Vị trí" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtViTri"
                             Style="{StaticResource ModtraTextBox}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="＋ Thêm"
                            Style="{StaticResource BtnPrimary}"
                            Margin="0,0,8,0"
                            Click="BtnThem_Click"/>
                    <Button Content="✏ Sửa"
                            Style="{StaticResource BtnSecondary}"
                            Margin="0,0,8,0"
                            Click="BtnSua_Click"/>
                    <Button Content="🗑 Xóa"
                            Style="{StaticResource BtnDanger}"
                            Click="BtnXoa_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── DATAGRID ── -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource LightShadow}">
            <DataGrid x:Name="dgLoaiDoUong"
                      Style="{StaticResource ModtraDataGrid}"
                      RowStyle="{StaticResource ModtraDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModtraColumnHeader}"
                      SelectionChanged="dgLoaiDoUong_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên loại"
                                        Binding="{Binding TenLoai}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Vị trí"
                                        Binding="{Binding ViTri}"
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
