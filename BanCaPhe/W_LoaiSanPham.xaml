<UserControl x:Class="BanCaPhe.W_LoaiSanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BanCaPhe"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel">

    <UserControl.DataContext>
        <vm:LoaiSanPhamViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Text="QUẢN LÝ DANH MỤC ĐỒ UỐNG"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

        <!-- FORM NHẬP -->
        <Border Grid.Row="1"
                Padding="15"
                CornerRadius="8"
                Background="#F5F5F5"
                Margin="0 0 0 15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TÊN LOẠI -->
                <StackPanel>
                    <TextBlock Text="Tên loại" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtTenLoai"
                             Text="{Binding TenLoai, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Margin="0 5 10 0"/>
                </StackPanel>

                <!-- VỊ TRÍ -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Vị trí" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtViTri"
                             Text="{Binding ViTri, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Margin="0 5 0 0"/>
                </StackPanel>

                <!-- BUTTON -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="15 0 0 0">

                    <Button Content="Thêm"
                            Width="80"
                            Height="30"
                            Margin="0 0 5 0"
                            Command="{Binding ThemCommand}"/>

                    <Button Content="Sửa"
                            Width="80"
                            Height="30"
                            Margin="0 0 5 0"
                            Command="{Binding SuaCommand}"/>

                    <Button Content="Xóa"
                            Width="80"
                            Height="30"
                            Background="#E57373"
                            Foreground="White"
                            Command="{Binding XoaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GRID -->
        <DataGrid x:Name="dgLoaiDoUong"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="35"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhMucList}"
                  SelectedItem="{Binding SelectedDanhMuc}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên loại"
                                    Binding="{Binding TenLoai}"
                                    Width="*"/>

                <DataGridTextColumn Header="Vị trí"
                                    Binding="{Binding ViTri}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
