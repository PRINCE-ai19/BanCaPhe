<Window x:Class="BanCaPhe.Views.W_KhachHangModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khách hàng"
        Height="350"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFF">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#2D5F3F"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <StackPanel Grid.Row="1">
            <!-- HỌ TÊN -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Họ tên khách hàng" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="#6B8B7E"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" 
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Foreground="#2D5F3F"
                         Background="#F1F8F4"
                         Style="{StaticResource DefaultTextBoxStyle}"/>
            </StackPanel>

            <!-- SỐ ĐIỆN THOẠI -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Số điện thoại" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="#6B8B7E"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" 
                         Height="40" 
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Foreground="#2D5F3F"
                         Background="#F1F8F4"
                         Style="{StaticResource DefaultTextBoxStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" 
                    Width="100" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Lưu" 
                    Width="120" 
                    Height="40" 
                    Style="{StaticResource SuccessButtonStyle}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
