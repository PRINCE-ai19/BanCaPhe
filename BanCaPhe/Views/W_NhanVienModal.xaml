<Window x:Class="BanCaPhe.Views.W_NhanVienModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modtra — Nhân viên"
        Height="580" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Border Background="White" CornerRadius="16" Margin="16" Padding="24" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Thông tin Nhân viên" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ tên" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtHoTen" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Số điện thoại" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtSoDienThoai" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <StackPanel x:Name="pnlMatKhau" Margin="0,0,0,14">
                        <TextBlock Text="Mật khẩu" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="txtMatKhau" Style="{StaticResource ModtraPasswordBox}"/>
                    </StackPanel>

                    <TextBlock Text="Vai trò" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="cbVaiTro" Style="{StaticResource ModtraComboBox}" Margin="0,0,0,16">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Employee"/>
                    </ComboBox>

                    <CheckBox x:Name="chkTrangThai" Content="Đang hoạt động" IsChecked="True" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Ảnh đại diện" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Width="150" Height="150" CornerRadius="75" Background="{StaticResource BgMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" ClipToBounds="True">
                        <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                    </Border>
                    <Button Content="Chọn ảnh" Style="{StaticResource BtnSecondary}" Width="130" Height="38" Margin="0,12,0,0" Click="BtnChonAnh_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="100" Margin="0,0,10,0" Click="BtnHuy_Click"/>
                <Button Content="💾  Lưu" Style="{StaticResource BtnPrimary}" Width="110" Click="BtnLuu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
