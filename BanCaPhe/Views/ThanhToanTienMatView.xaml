<Window x:Class="BanCaPhe.Views.ThanhToanTienMatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán tiền mặt"
        Height="650" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PHẦN BÊN TRÁI -->
        <StackPanel Grid.Column="0" Grid.RowSpan="4">
            <!-- Khách hàng -->
            <TextBlock Text="Số điện thoại khách hàng"
                       FontSize="14"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         Style="{StaticResource DefaultTextBoxStyle}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding TimKhachHangCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" 
                        Content="Tìm" 
                        Width="60" 
                        Height="40" 
                        Margin="5,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding TimKhachHangCommand}"/>
            </Grid>

            <!-- Hiển thị tên khách hàng nếu tìm thấy -->
            <TextBlock Text="{Binding KhachHang.HoTen}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Visibility="{Binding HasKhachHang, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,-10,0,10"/>

            <!-- Chi tiết tiền -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tổng tiền gốc:" FontSize="14" Foreground="{StaticResource OnSurfaceBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding TongTienGoc, StringFormat={}{0:N0} đ}" FontSize="14" Foreground="{StaticResource OnSurfaceBrush}"/>

                <TextBlock Grid.Row="1" Text="Giảm giá (thành viên):" FontSize="14" Foreground="{StaticResource ErrorBrush}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GiamGia, StringFormat={}-{0:N0} đ}" FontSize="14" Foreground="{StaticResource ErrorBrush}" Margin="0,5,0,0"/>

                <TextBlock Grid.Row="2" Text="Tổng thanh toán" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TongTien, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,5,0,0"/>
            </Grid>

            <!-- Tiền khách đưa -->
            <TextBlock Text="Tiền khách đưa"
                       FontSize="14"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtTienKhachDua"
                     Height="50"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     Text="{Binding TienKhachDua, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                     Margin="0,0,0,20"
                     Style="{StaticResource DefaultTextBoxStyle}"/>

            <!-- Tiền thối -->
            <TextBlock Text="Tiền thối"
                       FontSize="14"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,5"/>
            <Border Background="{StaticResource TertiaryContainerBrush}"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="{Binding TienThoi, StringFormat={}{0:N0} đ}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TertiaryBrush}"
                           TextAlignment="Right"/>
            </Border>

            <!-- BÀN PHÍM SỐ -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Hàng 1 -->
                <Button Content="7" Grid.Row="0" Grid.Column="0" 
                        Command="{Binding NhapSoCommand}" CommandParameter="7"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="8" Grid.Row="0" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="8"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="9" Grid.Row="0" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="9"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="←" Grid.Row="0" Grid.Column="3"
                        Command="{Binding XoaCommand}"
                        Margin="2" FontSize="20" FontWeight="Bold"
                        Style="{StaticResource ErrorButtonStyle}"/>

                <!-- Hàng 2 -->
                <Button Content="4" Grid.Row="1" Grid.Column="0"
                        Command="{Binding NhapSoCommand}" CommandParameter="4"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="5"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="6"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="000" Grid.Row="1" Grid.Column="3"
                        Command="{Binding NhapSoCommand}" CommandParameter="000"
                        Margin="2" FontSize="18" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>

                <!-- Hàng 3 -->
                <Button Content="1" Grid.Row="2" Grid.Column="0"
                        Command="{Binding NhapSoCommand}" CommandParameter="1"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="2"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="3"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="00" Grid.Row="2" Grid.Column="3"
                        Command="{Binding NhapSoCommand}" CommandParameter="00"
                        Margin="2" FontSize="18" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>

                <!-- Hàng 4 -->
                <Button Content="C" Grid.Row="3" Grid.Column="0"
                        Command="{Binding XoaHetCommand}"
                        Margin="2" FontSize="20" FontWeight="Bold"
                        Style="{StaticResource ErrorButtonStyle}"/>
                <Button Content="0" Grid.Row="3" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="0"
                        Margin="2" FontSize="20" FontWeight="Bold" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Vừa đủ" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                        Command="{Binding VuaDuCommand}"
                        Margin="2" FontSize="16" FontWeight="Bold"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </StackPanel>

        <!-- PHẦN BÊN PHẢI - CÁC NÚT MỆNH GIÁ -->
        <StackPanel Grid.Column="2" Grid.RowSpan="4">
            <TextBlock Text="Mệnh giá"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>

            <Button Content="500.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="500000"/>

            <Button Content="200.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource ErrorButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="200000"/>

            <Button Content="100.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="100000"/>

            <Button Content="50.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource SuccessButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="50000"/>

            <Button Content="20.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="20000"/>

            <Button Content="10.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="10000"/>
        </StackPanel>

        <!-- NÚT HỦY VÀ XÁC NHẬN -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Hủy"
                    Width="100"
                    Height="45"
                    Margin="0,0,10,0"
                    FontSize="16"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding HuyCommand}"/>
            <Button Content="Xác nhận thanh toán"
                    Width="180"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Style="{StaticResource SuccessButtonStyle}"
                    Command="{Binding XacNhanCommand}"/>
        </StackPanel>
    </Grid>
</Window>