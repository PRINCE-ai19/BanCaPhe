<Window x:Class="BanCaPhe.Views.ThanhToanTienMatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modtra — Thanh toán tiền mặt"
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="190"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ BÊN TRÁI: Thông tin + Numpad ══ -->
        <StackPanel Grid.Column="0" Grid.Row="0">

            <!-- Tổng tiền -->
            <Border Background="White" CornerRadius="14" Padding="16,12"
                    Margin="0,0,0,14" Effect="{StaticResource LightShadow}">
                <StackPanel>
                    <TextBlock Text="Tổng tiền"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tiền khách đưa -->
            <TextBlock Text="Tiền khách đưa" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="txtTienKhachDua"
                     Height="54"
                     FontSize="26" FontWeight="Bold"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Padding="12,0"
                     Style="{StaticResource ModtraTextBox}"
                     Text="{Binding TienKhachDua, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                     Margin="0,0,0,14"/>

            <!-- Tiền thối -->
            <TextBlock Text="Tiền thối" Style="{StaticResource FormLabel}"/>
            <Border Background="{StaticResource SuccessLightBrush}"
                    CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,14">
                <TextBlock Text="{Binding TienThoi, StringFormat={}{0:N0} đ}"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}"
                           TextAlignment="Right"/>
            </Border>

            <!-- NUMPAD -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="66"/>
                </Grid.RowDefinitions>

                <Button Content="7" Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="7"/>
                <Button Content="8" Grid.Row="0" Grid.Column="1" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="8"/>
                <Button Content="9" Grid.Row="0" Grid.Column="2" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="9"/>
                <Button Content="←" Grid.Row="0" Grid.Column="3" Style="{StaticResource BtnNumpad}" Background="{StaticResource DangerLightBrush}" Foreground="{StaticResource DangerBrush}" Command="{Binding XoaCommand}"/>

                <Button Content="4" Grid.Row="1" Grid.Column="0" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="4"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="5"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="6"/>
                <Button Content="000" Grid.Row="1" Grid.Column="3" Style="{StaticResource BtnNumpad}" FontSize="16" Command="{Binding NhapSoCommand}" CommandParameter="000"/>

                <Button Content="1" Grid.Row="2" Grid.Column="0" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="1"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="2"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="3"/>
                <Button Content="00" Grid.Row="2" Grid.Column="3" Style="{StaticResource BtnNumpad}" FontSize="16" Command="{Binding NhapSoCommand}" CommandParameter="00"/>

                <Button Content="C" Grid.Row="3" Grid.Column="0" Style="{StaticResource BtnNumpad}" Background="{StaticResource DangerLightBrush}" Foreground="{StaticResource DangerBrush}" Command="{Binding XoaHetCommand}"/>
                <Button Content="0" Grid.Row="3" Grid.Column="1" Style="{StaticResource BtnNumpad}" Command="{Binding NhapSoCommand}" CommandParameter="0"/>
                <Button Content="Vừa đủ" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource BtnNumpad}" FontSize="14" Background="{StaticResource InfoLightBrush}" Foreground="{StaticResource InfoBrush}" Command="{Binding VuaDuCommand}"/>
            </Grid>
        </StackPanel>

        <!-- ══ BÊN PHẢI: Mệnh giá ══ -->
        <StackPanel Grid.Column="2" Grid.Row="0">
            <TextBlock Text="Mệnh giá"
                       Style="{StaticResource FormLabel}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Button Content="500.000 đ" Height="58" Margin="0,0,0,8" FontSize="15" FontWeight="Bold" Foreground="White" BorderThickness="0" Command="{Binding ChonMenhGiaCommand}" CommandParameter="500000">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}"><Setter Property="Background" Value="#7E57C2"/></Style></Button.Style>
            </Button>
            <Button Content="200.000 đ" Height="58" Margin="0,0,0,8" FontSize="15" Style="{StaticResource BtnDanger}" FontWeight="Bold" Command="{Binding ChonMenhGiaCommand}" CommandParameter="200000"/>
            <Button Content="100.000 đ" Height="58" Margin="0,0,0,8" FontSize="15" FontWeight="Bold" Foreground="White" BorderThickness="0" Command="{Binding ChonMenhGiaCommand}" CommandParameter="100000">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}"><Setter Property="Background" Value="{StaticResource InfoBrush}"/></Style></Button.Style>
            </Button>
            <Button Content="50.000 đ" Height="58" Margin="0,0,0,8" FontSize="15" Style="{StaticResource BtnPrimary}" FontWeight="Bold" Command="{Binding ChonMenhGiaCommand}" CommandParameter="50000"/>
            <Button Content="20.000 đ" Height="58" Margin="0,0,0,8" FontSize="15" FontWeight="Bold" Foreground="White" BorderThickness="0" Command="{Binding ChonMenhGiaCommand}" CommandParameter="20000">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}"><Setter Property="Background" Value="{StaticResource WarningBrush}"/></Style></Button.Style>
            </Button>
            <Button Content="10.000 đ" Height="58" Margin="0" FontSize="15" FontWeight="Bold" Foreground="White" BorderThickness="0" Command="{Binding ChonMenhGiaCommand}" CommandParameter="10000">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}"><Setter Property="Background" Value="#795548"/></Style></Button.Style>
            </Button>
        </StackPanel>

        <!-- ══ NÚT HỦY + XÁC NHẬN ══ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="110" Height="46" Margin="0,0,12,0" Command="{Binding HuyCommand}"/>
            <Button Content="✅  Xác nhận thanh toán" Style="{StaticResource BtnPrimary}" Width="200" Height="46" FontSize="15" Command="{Binding XacNhanCommand}"/>
        </StackPanel>
    </Grid>
</Window>