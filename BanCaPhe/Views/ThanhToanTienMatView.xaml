<Window x:Class="BanCaPhe.Views.ThanhToanTienMatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán tiền mặt"
        Height="650" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PHẦN BÊN TRÁI -->
        <StackPanel Grid.Column="0" Grid.RowSpan="4">
            <!-- Tổng tiền -->
            <TextBlock Text="Tổng tiền"
                       FontSize="14"
                       Margin="0,0,0,5"/>
            <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="Red"
                       Margin="0,0,0,20"/>

            <!-- Tiền khách đưa -->
            <TextBlock Text="Tiền khách đưa"
                       FontSize="14"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtTienKhachDua"
                     Height="50"
                     FontSize="24"
                     FontWeight="Bold"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     Text="{Binding TienKhachDua, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                     Margin="0,0,0,20"/>

            <!-- Tiền thối -->
            <TextBlock Text="Tiền thối"
                       FontSize="14"
                       Margin="0,0,0,5"/>
            <Border Background="#E8F5E9"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock Text="{Binding TienThoi, StringFormat={}{0:N0} đ}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           TextAlignment="Right"/>
            </Border>

            <!-- BÀN PHÍM SỐ -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Hàng 1 -->
                <Button Content="7" Grid.Row="0" Grid.Column="0" 
                        Command="{Binding NhapSoCommand}" CommandParameter="7"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="8" Grid.Row="0" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="8"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="9" Grid.Row="0" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="9"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="←" Grid.Row="0" Grid.Column="3"
                        Command="{Binding XoaCommand}"
                        Margin="2" FontSize="20" FontWeight="Bold"
                        Background="#FFE0E0"/>

                <!-- Hàng 2 -->
                <Button Content="4" Grid.Row="1" Grid.Column="0"
                        Command="{Binding NhapSoCommand}" CommandParameter="4"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="5"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="6"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="000" Grid.Row="1" Grid.Column="3"
                        Command="{Binding NhapSoCommand}" CommandParameter="000"
                        Margin="2" FontSize="18" FontWeight="Bold"/>

                <!-- Hàng 3 -->
                <Button Content="1" Grid.Row="2" Grid.Column="0"
                        Command="{Binding NhapSoCommand}" CommandParameter="1"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="2"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2"
                        Command="{Binding NhapSoCommand}" CommandParameter="3"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="00" Grid.Row="2" Grid.Column="3"
                        Command="{Binding NhapSoCommand}" CommandParameter="00"
                        Margin="2" FontSize="18" FontWeight="Bold"/>

                <!-- Hàng 4 -->
                <Button Content="C" Grid.Row="3" Grid.Column="0"
                        Command="{Binding XoaHetCommand}"
                        Margin="2" FontSize="20" FontWeight="Bold"
                        Background="#FFE0E0"/>
                <Button Content="0" Grid.Row="3" Grid.Column="1"
                        Command="{Binding NhapSoCommand}" CommandParameter="0"
                        Margin="2" FontSize="20" FontWeight="Bold"/>
                <Button Content="Vừa đủ" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                        Command="{Binding VuaDuCommand}"
                        Margin="2" FontSize="16" FontWeight="Bold"
                        Background="#E3F2FD"/>
            </Grid>
        </StackPanel>

        <!-- PHẦN BÊN PHẢI - CÁC NÚT MỆNH GIÁ -->
        <StackPanel Grid.Column="2" Grid.RowSpan="4">
            <TextBlock Text="Mệnh giá"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>

            <Button Content="500.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#9C27B0"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="500000"/>

            <Button Content="200.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#F44336"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="200000"/>

            <Button Content="100.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#2196F3"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="100000"/>

            <Button Content="50.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="50000"/>

            <Button Content="20.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#FF9800"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="20000"/>

            <Button Content="10.000 đ"
                    Height="60"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#795548"
                    Foreground="White"
                    Command="{Binding ChonMenhGiaCommand}"
                    CommandParameter="10000"/>
        </StackPanel>

        <!-- NÚT HỦY VÀ XÁC NHẬN -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Hủy"
                    Width="100"
                    Height="45"
                    Margin="0,0,10,0"
                    FontSize="16"
                    Command="{Binding HuyCommand}"/>
            <Button Content="Xác nhận thanh toán"
                    Width="180"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    Command="{Binding XacNhanCommand}"/>
        </StackPanel>
    </Grid>
</Window>