<Window x:Class="BanCaPhe.Views.W_DoiMatKhauModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modtra — Đổi mật khẩu"
        Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Border Background="White" CornerRadius="16" Margin="16" Padding="24" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="🔑" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="Đổi mật khẩu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="txtInfo" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="txtMatKhauMoi" Style="{StaticResource ModtraPasswordBox}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,0">
                <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="txtXacNhan" Style="{StaticResource ModtraPasswordBox}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="100" Margin="0,0,10,0" Click="BtnHuy_Click"/>
                <Button Content="Đổi mật khẩu" Style="{StaticResource BtnPrimary}" Width="130" Click="BtnDoiMatKhau_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
