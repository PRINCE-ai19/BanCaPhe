<Window x:Class="BanCaPhe.Views.W_ToppingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Topping"
        Height="450"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- FORM -->
            <GroupBox Header="Thông tin topping" Margin="0,0,10,0" Foreground="{StaticResource OnSurfaceBrush}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Tên topping" Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBox Text="{Binding Topping.TenTopping, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Giá" Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBox Text="{Binding Topping.Gia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultTextBoxStyle}"/>
                    </StackPanel>

                    <CheckBox Grid.Row="2"
                              Content="Có thể bán riêng"
                              IsChecked="{Binding Topping.CoTheBanRieng}"
                              Foreground="{StaticResource OnSurfaceBrush}"/>

                    <CheckBox Grid.Row="3"
                              Content="Còn bán"
                              IsChecked="{Binding Topping.ConBan}"
                              Foreground="{StaticResource OnSurfaceBrush}"/>
                </Grid>
            </GroupBox>

            <!-- HÌNH -->
            <GroupBox Grid.Column="1" Header="Hình ảnh" Foreground="{StaticResource OnSurfaceBrush}">
                <StackPanel Margin="10" HorizontalAlignment="Center">
                    <Border Width="140"
                            Height="140"
                            BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="70"
                            Background="{StaticResource SurfaceContainerLowestBrush}">
                        <Image Source="{Binding ImagePreview}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <Button Content="Chọn ảnh"
                            Width="110"
                            Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ChonAnhCommand}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ERROR MESSAGE -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="5,10,5,0"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

        <!-- BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Lưu"
                    Width="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource SuccessButtonStyle}"
                    Command="{Binding LuuCommand}"/>
            <Button Content="Hủy"
                    Width="90"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding HuyCommand}"/>
        </StackPanel>
    </Grid>
</Window>
