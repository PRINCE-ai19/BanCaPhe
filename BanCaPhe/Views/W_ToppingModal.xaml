<Window x:Class="BanCaPhe.Views.W_ToppingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modtra — Topping"
        Height="440" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Border Background="White" CornerRadius="16" Margin="16" Padding="24" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Thông tin Topping" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tên topping" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtTen" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Giá (đ)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtGia" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,20"/>

                    <CheckBox x:Name="chkBanRieng" Content="Có thể bán riêng" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkConBan" Content="Còn bán" IsChecked="True" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Hình ảnh" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Width="140" Height="140" CornerRadius="70" Background="{StaticResource BgMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" ClipToBounds="True">
                        <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                    </Border>
                    <Button Content="Chọn ảnh" Style="{StaticResource BtnSecondary}" Width="130" Height="38" Margin="0,12,0,0" Click="BtnChonAnh_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="100" Margin="0,0,10,0" Click="BtnHuy_Click"/>
                <Button Content="💾  Lưu" Style="{StaticResource BtnPrimary}" Width="110" Click="BtnLuu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
