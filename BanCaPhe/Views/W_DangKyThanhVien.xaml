<Window x:Class="BanCaPhe.Views.W_DangKyThanhVien"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Đăng ký thành viên"
        Height="380"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">

    <Window.DataContext>
        <vm:DangKyThanhVienViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ĐĂNG KÝ THÀNH VIÊN" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="#2D5F3F"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,30"/>

        <!-- HỌ TÊN -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Họ tên khách hàng" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Foreground="#2D5F3F"
                       Margin="0,0,0,8"/>
            <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" 
                     Height="45" 
                     FontSize="16"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Foreground="#2D5F3F"
                     Background="#F1F8F4"
                     Style="{StaticResource DefaultTextBoxStyle}"/>
        </StackPanel>

        <!-- SỐ ĐIỆN THOẠI -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Số điện thoại" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       Foreground="#2D5F3F"
                       Margin="0,0,0,8"/>
            <TextBox Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" 
                     Height="45" 
                     FontSize="16"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Foreground="#2D5F3F"
                     Background="#F1F8F4"
                     Style="{StaticResource DefaultTextBoxStyle}"/>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" 
                    Width="110" 
                    Height="45" 
                    Margin="0,0,12,0"
                    FontSize="14"
                    FontWeight="Bold"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding HuyCommand}"/>
            <Button Content="Đăng ký" 
                    Width="130" 
                    Height="45" 
                    FontSize="14"
                    FontWeight="Bold"
                    Style="{StaticResource SuccessButtonStyle}"
                    Command="{Binding DangKyCommand}"/>
        </StackPanel>
    </Grid>
</Window>
