<Window x:Class="BanCaPhe.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Chi tiết sản phẩm"
        Width="400"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Padding="15" Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- HÌNH ẢNH -->
                <Image Source="{Binding SanPham.HinhAnh, Converter={StaticResource ImagePathConverter}}"
                       Height="180"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>

                <!-- TÊN SẢN PHẨM -->
                <TextBlock Text="{Binding SanPham.TenDoUong}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- CHỌN SIZE -->
                <TextBlock Text="Chọn size"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ItemsControl ItemsSource="{Binding DanhSachKichThuoc}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding TenKichThuoc}"
                                         GroupName="Size"
                                         Margin="5"
                                         Padding="10,5"
                                         FontWeight="Bold"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.ChonSizeCommand,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#CCC"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border CornerRadius="20"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#FF007ACC"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- PHẦN TOPPING (CHỈ HIỂN THỊ CHO TRÀ SỮA) -->
                <StackPanel Visibility="{Binding LaTraSua, Converter={StaticResource BoolToVis}}"
                            Margin="0,15,0,0">

                    <TextBlock Text="🧋 Thêm topping"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>

                    <!-- CHỌN TOPPING -->
                    <ComboBox ItemsSource="{Binding DanhSachTopping}"
                              SelectedItem="{Binding SelectedTopping}"
                              DisplayMemberPath="TenTopping"
                              Height="35"
                              Margin="0,0,0,10"/>

                    <!-- SỐ LƯỢNG TOPPING VÀ NÚT THÊM -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                      
                        <!-- NÚT THÊM TOPPING -->
                        <Button Grid.Column="1"
                                Content="Thêm"
                                Width="80"
                                Height="30"
                                Background="#4CAF50"
                                Foreground="White"
                                Command="{Binding ThemToppingCommand}"/>
                    </Grid>

                    <!-- DANH SÁCH TOPPING ĐÃ CHỌN -->
                    <ItemsControl ItemsSource="{Binding DanhSachToppingDaChon}"
                                  Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3"
                                        Padding="8"
                                        Background="#F5F5F5"
                                        CornerRadius="5"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Ten}" FontWeight="SemiBold"/>
                                            <Run Text=" x"/>
                                            <Run Text="{Binding SoLuong}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}"
                                                   FontWeight="Bold"
                                                   Foreground="#FF5722"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>

                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Width="25"
                                                Height="25"
                                                FontSize="12"
                                                Background="#FFCDD2"
                                                Command="{Binding DataContext.XoaToppingCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ĐƯỜNG PHÂN CÁCH -->
                    <Separator Margin="0,10"/>
                </StackPanel>

                <!-- GIÁ -->
                <TextBlock Text="Giá"
                           FontWeight="Bold"
                           Margin="0,15,0,5"/>

                <TextBlock FontSize="20"
                           FontWeight="Bold"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           Text="{Binding TongTien, StringFormat={}{0:N0} đ}"/>

                <!-- SỐ LƯỢNG -->
                <TextBlock Text="Số lượng"
                           FontWeight="Bold"
                           Margin="0,15,0,5"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button Content="-" 
                            Width="40"
                            Command="{Binding GiamSoLuongCommand}"/>
                    <TextBlock Text="{Binding SoLuong}"
                               Width="50"
                               FontSize="16"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Content="+" 
                            Width="40"
                            Command="{Binding TangSoLuongCommand}"/>
                </StackPanel>

                <!-- THÊM VÀO GIỎ -->
                <Button Content="Thêm vào giỏ hàng"
                        Height="45"
                        Margin="0,20,0,0"
                        Background="#FF4CAF50"
                        Foreground="White"
                        Command="{Binding ThemVaoGioCommand}"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>