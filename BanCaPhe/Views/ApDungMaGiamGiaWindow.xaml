<Window x:Class="BanCaPhe.Views.ApDungMaGiamGiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modtra — Áp dụng mã giảm giá"
        Width="700" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎁" FontSize="32" Margin="0,0,12,0"/>
                <TextBlock Text="Áp dụng mã giảm giá"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Tìm kiếm khách hàng và chọn mã giảm giá"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ══════════════ TÌM KIẾM KHÁCH HÀNG ══════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Tìm kiếm khách hàng"
                           Style="{StaticResource FormLabel}"
                           Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtSearch"
                             Grid.Column="0"
                             Style="{StaticResource ModtraTextBox}"
                             FontSize="15"
                             Height="44"
                             VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12,0,0,12"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="🔍  Tìm kiếm"
                            Style="{StaticResource BtnPrimary}"
                            Height="44"
                            Padding="20,0"
                            FontSize="15"
                            Click="BtnTimKiem_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,12,12,0"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <TextBlock Text="💡 Nhập họ tên hoặc số điện thoại"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="4,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════ KẾT QUẢ & VOUCHER ══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- DANH SÁCH KHÁCH HÀNG -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Kết quả tìm kiếm"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="dgKhachHang"
                              Grid.Row="1"
                              Style="{StaticResource ModtraDataGrid}"
                              RowStyle="{StaticResource ModtraDataGridRow}"
                              ColumnHeaderStyle="{StaticResource ModtraColumnHeader}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              SelectionChanged="DgKhachHang_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding HoTen}"
                                                Width="*"/>
                            <DataGridTextColumn Header="SĐT"
                                                Binding="{Binding SoDienThoai}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Điểm"
                                                Binding="{Binding DiemTichLuy}"
                                                Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DANH SÁCH VOUCHER -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Mã giảm giá khả dụng"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icVouchers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            CornerRadius="12"
                                            Margin="0,0,0,10"
                                            Padding="14"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1.5"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="Voucher_Click"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <!-- Mã code -->
                                            <Border Background="{StaticResource SuccessLightBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,8">
                                                <TextBlock Text="{Binding MaCode}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>

                                            <!-- Tên chương trình -->
                                            <TextBlock Text="{Binding TenChuongTrinh}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,6"/>

                                            <!-- Giá trị giảm -->
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4">
                                                <Run Text="Giảm:"/>
                                                <Run Text="{Binding GiaTriGiamDisplay}"/>
                                            </TextBlock>

                                            <!-- Điều kiện -->
                                            <TextBlock Text="{Binding DieuKienDisplay}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1"
                                x:Name="pnlEmptyVoucher"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="🎫" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock Text="Chọn khách hàng để xem voucher"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ FOOTER - BUTTONS ══════════════ -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Đóng"
                    Style="{StaticResource BtnSecondary}"
                    Height="46"
                    Margin="0,0,10,0"
                    Click="BtnDong_Click"/>

            <Button Grid.Column="1"
                    x:Name="btnXacNhan"
                    Content="✅  Xác nhận áp dụng"
                    Style="{StaticResource BtnPrimary}"
                    Height="46"
                    Width="200"
                    FontSize="15"
                    IsEnabled="False"
                    Click="BtnXacNhan_Click"/>
        </Grid>
    </Grid>
</Window>
