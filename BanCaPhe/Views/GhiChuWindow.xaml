<Window x:Class="BanCaPhe.Views.GhiChuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghi chú món"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15" Width="300">


      
        <TextBlock Text="Ghi chú" FontWeight="Bold" Margin="0,10,0,0"/>
        <TextBox Text="{Binding GhiChu}"
                 AcceptsReturn="True"
                 Height="60"/>

        <!-- GHI CHÚ NHANH -->
        <WrapPanel Margin="0,10,0,0">
            <Button Content="0% đường" Command="{Binding ChonNhanhCommand}" CommandParameter="0% đường"/>
            <Button Content="Ít đường" Command="{Binding ChonNhanhCommand}" CommandParameter="Ít đường"/>
            <Button Content="0% đá" Command="{Binding ChonNhanhCommand}" CommandParameter="0% đá"/>
            <Button Content="Ít đá" Command="{Binding ChonNhanhCommand}" CommandParameter="Ít đá"/>
        </WrapPanel>

        <Button Content="Xong"
                Margin="0,15,0,0"
                Height="35"
                Background="#4CAF50"
                Foreground="White"
                Command="{Binding DongCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </StackPanel>
</Window>
