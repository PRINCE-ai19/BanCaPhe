<Window x:Class="BanCaPhe.Views.GhiChuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghi chú món"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="16"
            Background="White"
            Width="340"
            Padding="24"
            Effect="{StaticResource CardShadow}">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="📝" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="Ghi chú món"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Textarea -->
            <TextBlock Text="Nội dung ghi chú" Style="{StaticResource FormLabel}"/>
            <TextBox Text="{Binding GhiChu}"
                     AcceptsReturn="True"
                     MinHeight="70"
                     Style="{StaticResource ModtraTextBoxMulti}"
                     Margin="0,0,0,16"/>

            <!-- Quick tags -->
            <TextBlock Text="Chọn nhanh" Style="{StaticResource FormLabel}"/>
            <WrapPanel Margin="0,0,0,20">
                <Button Content="0% đường"
                        Style="{StaticResource BtnChip}"
                        Command="{Binding ChonNhanhCommand}"
                        CommandParameter="0% đường"/>
                <Button Content="Ít đường"
                        Style="{StaticResource BtnChip}"
                        Command="{Binding ChonNhanhCommand}"
                        CommandParameter="Ít đường"/>
                <Button Content="Không đá"
                        Style="{StaticResource BtnChip}"
                        Command="{Binding ChonNhanhCommand}"
                        CommandParameter="0% đá"/>
                <Button Content="Ít đá"
                        Style="{StaticResource BtnChip}"
                        Command="{Binding ChonNhanhCommand}"
                        CommandParameter="Ít đá"/>
            </WrapPanel>

            <!-- Confirm -->
            <Button Content="✔  Xong"
                    Style="{StaticResource BtnPrimary}"
                    Height="44"
                    Command="{Binding DongCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Border>
</Window>
