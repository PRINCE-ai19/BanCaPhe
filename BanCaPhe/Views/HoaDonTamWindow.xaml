<Window x:Class="BanCaPhe.Views.HoaDonTamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hóa đơn tạm"
        Width="420"
        Height="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="HÓA ĐƠN TẠM"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>


        <!-- DANH SÁCH MÓN -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  BorderThickness="0">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8"
                            Margin="0,0,0,8"
                            CornerRadius="6"
                            Background="#F5F5F5">

                        <StackPanel>

                            <!-- TÊN + SIZE -->
                            <TextBlock FontWeight="Bold">
                                <Run Text="{Binding Ten}"/>
                                <Run Text=" (" />
                                <Run Text="{Binding Size}" />
                                <Run Text=")" />
                            </TextBlock>

                            <!-- DANH SÁCH TOPPING -->
                            <ItemsControl ItemsSource="{Binding Toppings}"
                                         Margin="10,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11"
                                                  Foreground="#555">
                                            <Run Text="+ "/>
                                            <Run Text="{Binding Ten}"/>
                                            <Run Text=" x"/>
                                            <Run Text="{Binding SoLuong}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding Gia, StringFormat={}{0:N0}}"/>
                                            <Run Text=" đ)"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- GHI CHÚ -->
                            <TextBlock Text="{Binding GhiChu}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="Gray"
                                       Margin="0,2,0,0"/>

                            <!-- SL + GIÁ -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text= "{Binding SoLuong}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}"
                                           FontWeight="Bold"
                                           Foreground="Red"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2">

            <Separator/>

            <TextBlock Text="{Binding TongTien, StringFormat=Tổng tiền tạm tính: {0:N0} đ}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,5"/>

            <Button Content="Xuất PDF hóa đơn tạm"
                    Height="40"
                    Background="#FF1976D2"
                    Foreground="White"
                    Command="{Binding XuatPdfCommand}"/>
        </StackPanel>
    </Grid>
</Window>
