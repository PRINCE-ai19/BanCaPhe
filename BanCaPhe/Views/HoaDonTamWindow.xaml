<Window x:Class="BanCaPhe.Views.HoaDonTamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Hóa Đơn Tạm" Width="440" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                Padding="20,16" Margin="0,0,0,12"
                Effect="{StaticResource LightShadow}">
            <StackPanel>
                <TextBlock Text="MODTRA CÀ PHÊ"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="PHIẾU KIỂM ĐỒ"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="txtDate"
                           Text="Thời gian: 15/05/2026 14:30"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body: Chi tiết đơn hàng -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="16,4"
                Effect="{StaticResource LightShadow}">
            <ListView ItemsSource="{Binding DonHang}"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Top">
                                        <Run Text="x"/><Run Text="{Binding SoLuong}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Ten}"/>
                                        <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text="{Binding Size}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Topping list -->
                                <ItemsControl ItemsSource="{Binding Toppings}"
                                              Margin="36,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding SoLuong}"/><Run Text=" "/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Ten}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Note -->
                                <TextBlock Text="{Binding GhiChu, StringFormat='Ghi chú: {0}'}"
                                           FontStyle="Italic" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="36,4,0,0"
                                           Visibility="{Binding HasGhiChu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="🖨  Xuất PDF"
                    Style="{StaticResource BtnPrimary}"
                    Height="48" FontSize="16"/>
        </Grid>
    </Grid>
</Window>
