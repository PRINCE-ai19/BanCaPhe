<Window x:Class="BanCaPhe.Views.HoaDonTamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hóa đơn tạm"
        Width="700"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAF8">

    <StackPanel>
        <!-- HEADER -->
        <Border Background="#2D5F3F" Padding="20,15,20,15">
            <TextBlock Text="HÓA ĐƠN TẠM"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#FFFFFF"/>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- COLUMN HEADERS -->
            <Border Grid.Row="0" Background="#E8F0E8" Padding="12,10" CornerRadius="6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Sản phẩm" FontWeight="Bold" Foreground="#1F4D3D" FontSize="11" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="Số lượng" FontWeight="Bold" Foreground="#1F4D3D" FontSize="11" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Đơn giá" FontWeight="Bold" Foreground="#1F4D3D" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="Thành tiền" FontWeight="Bold" Foreground="#1F4D3D" FontSize="11" TextAlignment="Right" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- DANH SÁCH MÓN -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <!-- MAIN ITEM ROW -->
                                <Border Padding="12,10" Background="#FFFFFF" CornerRadius="6" BorderBrush="#D0E8DC" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Product Name + Size -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock FontWeight="Bold" Foreground="#1F4D3D" FontSize="11">
                                                <Run Text="{Binding Ten}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Size}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                            
                                            <!-- Toppings -->
                                            <ItemsControl ItemsSource="{Binding Toppings}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="9" Foreground="#4A7C6B">
                                                            <Run Text="+ "/>
                                                            <Run Text="{Binding Ten}"/>
                                                            <Run Text=" x"/>
                                                            <Run Text="{Binding SoLuong}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Notes -->
                                            <TextBlock Text="{Binding GhiChu}"
                                                       FontSize="9"
                                                       FontStyle="Italic"
                                                       Foreground="#6B8B7E"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Quantity -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SoLuong}" 
                                                   Foreground="#1F4D3D"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"/>

                                        <!-- Unit Price -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Gia, StringFormat={}{0:N0} đ}" 
                                                   Foreground="#2D7A5C"
                                                   FontWeight="Bold"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Margin="0,0,8,0"/>

                                        <!-- Total Price -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding ThanhTien, StringFormat={}{0:N0} đ}" 
                                                   Foreground="#2D7A5C"
                                                   FontWeight="Bold"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Margin="0,0,8,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <StackPanel Grid.Row="2">
                <!-- SEPARATOR -->
                <Border Height="2" Background="#A8D5BA" Margin="0,0,0,12"/>

                <!-- TOTAL -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Tổng tiền tạm tính:" 
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#1F4D3D"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2D7A5C"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- BUTTON -->
                <Button Content="Xuất PDF hóa đơn tạm"
                        Height="42"
                        Background="#2D7A5C"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Command="{Binding XuatPdfCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
