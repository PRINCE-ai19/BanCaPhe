<Window x:Class="BanCaPhe.Views.W_SanPhamModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Modtra — Sản phẩm"
        Height="540" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="16" Padding="24" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Thông tin Sản phẩm" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tên đồ uống" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtTen" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Giá (đ)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtGia" Style="{StaticResource ModtraTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Loại đồ uống" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="cbLoai" Style="{StaticResource ModtraComboBox}" DisplayMemberPath="TenLoai" SelectedValuePath="ID" Margin="0,0,0,14"/>

                    <TextBlock Text="Mô tả" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtMoTa" MinHeight="80" Style="{StaticResource ModtraTextBoxMulti}" Margin="0,0,0,16"/>

                    <CheckBox x:Name="chkConBan" Content="Còn bán" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Hình ảnh" Style="{StaticResource FormLabel}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Width="160" Height="160" CornerRadius="14" Background="{StaticResource BgMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Image x:Name="imgPreview" Stretch="Uniform" Margin="8"/>
                    </Border>
                    <Button Content="📷 Chọn hình" Style="{StaticResource BtnSecondary}" Width="140" Height="38" Margin="0,12,0,0" Click="BtnChonHinh_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Hủy" Style="{StaticResource BtnSecondary}" Width="100" Margin="0,0,10,0" Click="BtnHuy_Click"/>
                <Button Content="💾  Lưu" Style="{StaticResource BtnPrimary}" Width="110" Click="BtnLuu_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
