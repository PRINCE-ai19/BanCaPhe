<Window x:Class="BanCaPhe.Views.ThanhToanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="18" Background="White" Padding="24" Width="340" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <TextBlock Text="Phương thức thanh toán" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,20"/>

            <Button Height="52" Margin="0,0,0,10" Command="{Binding TienMatCommand}" FontSize="15" FontWeight="SemiBold" Style="{StaticResource BtnPrimary}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💵" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Tiền mặt" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Height="52" Margin="0,0,0,10" Command="{Binding ChuyenKhoanCommand}" FontSize="15" FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💳" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Chuyển khoản" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Height="52" Margin="0,0,0,20" Command="{Binding VnpayCommand}" FontSize="15" FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                        <Setter Property="Background" Value="#7E57C2"/>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📱" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="VNPay QR" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Content="Hủy" Height="40" Style="{StaticResource BtnSecondary}" Command="{Binding DongCommand}"/>
        </StackPanel>
    </Border>
</Window>
