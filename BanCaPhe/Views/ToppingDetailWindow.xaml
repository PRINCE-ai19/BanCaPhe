<Window x:Class="BanCaPhe.Views.ToppingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Thông tin Topping"
        Width="360"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{StaticResource SurfaceContainerLowestBrush}"
            Padding="20"
            Margin="10">
        <StackPanel>

            <!-- HÌNH ẢNH TOPPING -->
            <Border CornerRadius="8"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15"
                    Background="{StaticResource BackgroundBrush}">
                <Image Height="150"
                       Stretch="Uniform"
                       Source="{Binding Topping.HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
            </Border>

            <!-- TÊN TOPPING -->
            <TextBlock Text="{Binding Topping.TenTopping}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       Margin="0,0,0,10"/>

            <!-- GIÁ -->
            <TextBlock Text="{Binding Topping.Gia, StringFormat={}{0:N0} đ}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TertiaryBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <Separator Background="{StaticResource OutlineBrush}" Margin="0,10"/>

            <!-- NÚT ĐÓNG -->
            <Button Content="Đóng"
                    Height="45"
                    Margin="0,20,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding HuyCommand}"/>

        </StackPanel>
    </Border>
</Window>