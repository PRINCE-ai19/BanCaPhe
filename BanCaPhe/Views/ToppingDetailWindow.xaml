<Window x:Class="BanCaPhe.Views.ToppingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Thông tin Topping"
        Width="360"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="White"
            Padding="20"
            Margin="10">
        <StackPanel>

            <!-- HÌNH ẢNH TOPPING -->
            <Border CornerRadius="8"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,15"
                    Background="#FAFAFA">
                <Image Height="150"
                       Stretch="Uniform"
                       Source="{Binding Topping.HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
            </Border>

            <!-- TÊN TOPPING -->
            <TextBlock Text="{Binding Topping.TenTopping}"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- GIÁ -->
            <TextBlock Text="{Binding Topping.Gia, StringFormat={}{0:N0} đ}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#4CAF50"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <Separator Margin="0,10"/>

            <!-- NÚT ĐÓNG -->
            <Button Content="Đóng"
                    Height="45"
                    Margin="0,20,0,0"
                    Background="#607D8B"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    Command="{Binding HuyCommand}"/>

        </StackPanel>
    </Border>
</Window>