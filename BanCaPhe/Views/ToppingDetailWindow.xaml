<Window x:Class="BanCaPhe.Views.ToppingDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Thông tin Topping"
        Width="360" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgAppBrush}">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Padding="24" Margin="12" Effect="{StaticResource CardShadow}">
        <StackPanel>
            <Border CornerRadius="12" Background="{StaticResource BgMutedBrush}" Height="160" Margin="0,0,0,16">
                <Image Stretch="Uniform" Margin="12" Source="{Binding Topping.HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
            </Border>

            <TextBlock Text="{Binding Topping.TenTopping}" FontSize="22" FontWeight="Bold" TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

            <Border Background="{StaticResource SuccessLightBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                <TextBlock Text="{Binding Topping.Gia, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" TextAlignment="Center"/>
            </Border>

            <Button Content="Đóng" Style="{StaticResource BtnSecondary}" Height="44" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>