<Window x:Class="BanCaPhe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        xmlns:models="clr-namespace:BanCaPhe.Models"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Modtra - Matcha và Cà phê"
        Height="750"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>
    
    <Grid Background="#FAFAF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="30,15,30,15" BorderThickness="0,0,0,1" BorderBrush="#E8F0E8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🍵" FontSize="28" Margin="0,0,12,0"/>
                <TextBlock Text="MODTRA" FontSize="24" FontWeight="Bold" Foreground="#2D5F3F" VerticalAlignment="Center"/>
                <TextBlock Text="Matcha và Cà phê" FontSize="12" Foreground="#6B8B7E" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= DANH MỤC (LEFT) ================= -->
            <Border Grid.Column="0" Background="#E8F0E8" Padding="0">
                <StackPanel>
                    <!-- Header Danh mục -->
                    <Border Background="#2D5F3F" Padding="16,12,16,12">
                        <TextBlock Text="Danh mục" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Category List -->
                    <Border Padding="12,12,12,12">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding DanhMuc}"
                                     SelectedItem="{Binding SelectedDanhMuc}"
                                     DisplayMemberPath="TenLoai"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,0,0,12">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="38"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1F4D3D"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="0,2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#7EC9A3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#C8E6D7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Topping Section -->
                            <Border Background="#FFFFFF" Padding="12" CornerRadius="8" Cursor="Hand" Margin="0,0,0,12" BorderBrush="#D0E8DC" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding HienThiToppingCommand}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="🍯 Topping" FontSize="13" FontWeight="Bold" Foreground="#1F4D3D"/>
                                    <TextBlock Text="Đồ thêm" FontSize="11" Foreground="#4A7C6B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Logout Button -->
                            <Border Margin="0,0,0,0" Padding="12" CornerRadius="8" Background="#FFCDD2" Cursor="Hand" BorderBrush="#EF9A9A" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding LogoutCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⏻" FontSize="16" Foreground="#C62828" Margin="0,0,8,0"/>
                                    <TextBlock Text="ĐĂNG XUẤT" FontWeight="Bold" Foreground="#C62828" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= VERTICAL DIVIDER 1 ================= -->
            <Border Grid.Column="1" Background="#A8D5BA"/>

            <!-- ================= SẢN PHẨM (CENTER) ================= -->
            <Border Grid.Column="2" Background="#FFFFFF" Padding="0">
                <StackPanel>
                    <!-- Header Sản phẩm -->
                    <Border Background="#2D5F3F" Padding="20,12,20,12">
                        <TextBlock Text="Sản phẩm" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Products Grid -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Margin="0">
                        <ItemsControl ItemsSource="{Binding DanhSachHienThi}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.Resources>
                                <!-- TEMPLATE ĐỒ UỐNG -->
                                <DataTemplate DataType="{x:Type models:DoUong}">
                                    <Border Width="140" Height="180" Margin="8" Background="#F0F7F3" CornerRadius="12" 
                                            BorderBrush="#D0E8DC" BorderThickness="1" Cursor="Hand"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ChonSanPhamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border Padding="10">
                                            <StackPanel>
                                                <Border Width="120" Height="120" Background="#FFFFFF" CornerRadius="10" Padding="6" Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                                                    <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" 
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding TenDoUong}" FontWeight="Bold" TextAlignment="Center" 
                                                           TextWrapping="Wrap" Height="32" Foreground="#1F4D3D" FontSize="12"/>
                                                <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}" Foreground="#2D7A5C" 
                                                           FontWeight="Bold" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </DataTemplate>

                                <!-- TEMPLATE TOPPING -->
                                <DataTemplate DataType="{x:Type models:Topping}">
                                    <Border Width="140" Height="180" Margin="8" Background="#FFF9E6" CornerRadius="12" 
                                            BorderBrush="#F0D9A8" BorderThickness="1" Cursor="Hand"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ChonToppingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border Padding="10">
                                            <StackPanel>
                                                <Border Width="120" Height="120" Background="#FFFFFF" CornerRadius="10" Padding="6" Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                                                    <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" 
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding TenTopping}" FontWeight="Bold" TextAlignment="Center" 
                                                           TextWrapping="Wrap" Height="32" Foreground="#1F4D3D" FontSize="12"/>
                                                <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}" Foreground="#B8860B" 
                                                           FontWeight="Bold" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= VERTICAL DIVIDER 2 ================= -->
            <Border Grid.Column="3" Background="#A8D5BA"/>

            <!-- ================= GIỎ HÀNG (RIGHT) ================= -->
            <Border Grid.Column="4" Background="#E8F0E8" Padding="0">
                <StackPanel>
                    <!-- Header Giỏ hàng -->
                    <Border Background="#2D5F3F" Padding="16,12,16,12">
                        <TextBlock Text="Đơn hàng" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Order Items -->
                    <Border Padding="12">
                        <StackPanel>
                        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <ListView ItemsSource="{Binding DonHang}" 
                                      SelectedItem="{Binding SelectedItem}" 
                                      BorderThickness="0" 
                                      Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                            BorderThickness="0" CornerRadius="8" Margin="0,4">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick" 
                                                                          Command="{Binding DataContext.MoGhiChuCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </Border.InputBindings>
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D0E8DC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" CornerRadius="8" Background="#FFFFFF" Margin="0,0,0,4" BorderBrush="#D0E8DC" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold" FontSize="11" Foreground="#1F4D3D" Margin="0,0,0,4">
                                                    <Run Text="{Binding Ten}" />
                                                    <Run Text=" (" />
                                                    <Run Text="{Binding Size}" />
                                                    <Run Text=")" />
                                                </TextBlock>
                                                
                                                <TextBlock Text="{Binding GhiChu}" FontSize="10" Foreground="#4A7C6B" FontStyle="Italic" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                                <ItemsControl ItemsSource="{Binding Toppings}" Margin="0,0,0,6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="9" Foreground="#4A7C6B">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="• {0} x{1}">
                                                                        <Binding Path="Ten"/>
                                                                        <Binding Path="SoLuong"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="−" Width="24" Height="24" Command="{Binding GiamCommand}" 
                                                                Background="#D0E8DC" Foreground="#1F4D3D" FontWeight="Bold" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding SoLuong}" Width="28" TextAlignment="Center" 
                                                                   FontWeight="Bold" VerticalAlignment="Center" Foreground="#1F4D3D" FontSize="12"/>
                                                        <Button Content="+" Width="24" Height="24" Command="{Binding TangCommand}" 
                                                                Background="#D0E8DC" Foreground="#1F4D3D" FontWeight="Bold" FontSize="12" Margin="4,0,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding TongTien, StringFormat={}{0:N0} đ}" 
                                                               Foreground="#2D7A5C" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0" FontSize="11"/>

                                                    <Button Grid.Column="2" Content="✕" Width="24" Height="24" Background="#FFCDD2" 
                                                            Foreground="#C62828" Command="{Binding XoaCommand}" FontSize="12" FontWeight="Bold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Order Summary -->
                        <Border Background="#FFFFFF" Padding="12" CornerRadius="8" Margin="0,0,0,12" BorderBrush="#D0E8DC" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Tổng cộng:" FontWeight="Bold" Foreground="#1F4D3D" FontSize="12"/>
                                    <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}" 
                                               Foreground="#2D7A5C" FontWeight="Bold" HorizontalAlignment="Right" FontSize="13"/>
                                </Grid>

                                <Button Content="IN HÓA ĐƠN" Height="36" Background="#D0E8DC" Foreground="#1F4D3D" 
                                        FontWeight="Bold" FontSize="11" Command="{Binding InHoaDonTamCommand}" Margin="0,0,0,8" BorderThickness="0"/>
                                
                                <Button Content="THANH TOÁN" Height="40" Background="#2D7A5C" Foreground="#FFFFFF" 
                                        FontWeight="Bold" FontSize="12" Command="{Binding MoThanhToanCommand}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
