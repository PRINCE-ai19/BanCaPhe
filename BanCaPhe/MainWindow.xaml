<Window x:Class="BanCaPhe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        xmlns:local="clr-namespace:BanCaPhe.Models"
        Title="Modtra — Bán hàng"
        Height="680"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- Danh mục -->
            <ColumnDefinition Width="200"/>
            <!-- Sản phẩm -->
            <ColumnDefinition Width="*"/>
            <!-- Giỏ hàng -->
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ CỘT 1 — DANH MỤC ══════════════ -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}"
                Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="☕" FontSize="22" Margin="0,0,8,0"/>
                        <TextBlock Text="Modtra"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="ĐỒ UỐNG"
                               Style="{StaticResource FormLabel}"
                               Margin="4,0,0,8"/>

                    <ListBox ItemsSource="{Binding DanhMuc}"
                             SelectedItem="{Binding SelectedDanhMuc}"
                             DisplayMemberPath="TenLoai"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource CategoryItem}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="ĐỒ ĂN KÈM"
                               Style="{StaticResource FormLabel}"
                               Margin="4,18,0,8"/>

                    <ListBoxItem Style="{StaticResource CategoryItem}"
                                 Cursor="Hand"
                                 MouseLeftButtonDown="Topping_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧋" Margin="0,0,8,0"/>
                            <TextBlock Text="Topping"/>
                        </StackPanel>
                    </ListBoxItem>
                </StackPanel>

                <!-- Đăng xuất -->
                <Border Grid.Row="1"
                        Background="{StaticResource DangerLightBrush}"
                        CornerRadius="12"
                        Padding="14,10"
                        Cursor="Hand"
                        x:Name="LogoutBorder"
                        MouseLeftButtonUp="Logout_Click"
                        MouseEnter="Logout_MouseEnter"
                        MouseLeave="Logout_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏻" FontSize="18"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="ĐĂNG XUẤT"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════ CỘT 2 — SẢN PHẨM ══════════════ -->
        <Border Grid.Column="1"
                Style="{StaticResource Card}"
                Margin="0,0,10,0"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Sản phẩm"
                           Style="{StaticResource SectionTitle}"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DanhSachHienThi}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Resources>

                            <!-- TEMPLATE ĐỒ UỐNG -->
                            <DataTemplate DataType="{x:Type local:DoUong}">
                                <Border Width="155" Height="210"
                                        Margin="6" CornerRadius="14"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Effect="{StaticResource LightShadow}"
                                        MouseLeftButtonDown="SanPham_Click">
                                    <StackPanel>
                                        <Border CornerRadius="12,12,0,0"
                                                Background="{StaticResource BgMutedBrush}"
                                                Height="110">
                                            <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="Uniform"
                                                   Margin="8"/>
                                        </Border>
                                        <StackPanel Margin="10,8">
                                            <TextBlock Text="{Binding TenDoUong}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- TEMPLATE TOPPING -->
                            <DataTemplate DataType="{x:Type local:Topping}">
                                <Border Width="155" Height="190"
                                        Margin="6" CornerRadius="14"
                                        Background="#FFFEF5E7"
                                        BorderBrush="#FFE8D5A3"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Effect="{StaticResource LightShadow}"
                                        MouseLeftButtonDown="Toppingmua_Click">
                                    <StackPanel>
                                        <Border CornerRadius="12,12,0,0"
                                                Background="#FFF9EFC7"
                                                Height="90">
                                            <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                                                   Stretch="Uniform"
                                                   Margin="8"/>
                                        </Border>
                                        <StackPanel Margin="10,8">
                                            <TextBlock Text="{Binding TenTopping}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="TOPPING"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════ CỘT 3 — GIỎ HÀNG / ĐƠN HÀNG ══════════════ -->
        <Border Grid.Column="2"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🛒" FontSize="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Đơn hàng"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"/>
                </StackPanel>

                <!-- Danh sách item -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding DonHang}"
                          SelectedItem="{Binding SelectedItem}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick"
                                         Handler="ListViewItem_DoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource OrderCard}">
                                <StackPanel>
                                    <!-- Tên + size -->
                                    <TextBlock FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Ten}"/>
                                        <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text="{Binding Size}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>

                                    <!-- Ghi chú -->
                                    <TextBlock Text="{Binding GhiChu}"
                                               FontSize="12"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,3,0,0"/>

                                    <!-- Topping list -->
                                    <ItemsControl ItemsSource="{Binding Toppings}"
                                                  Margin="8,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="•  "
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Ten}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" x" FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding SoLuong}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="  " FontSize="12"/>
                                                    <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Row dưới: SL +/- · Giá · Xóa -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Qty control -->
                                        <Border Grid.Column="0"
                                                CornerRadius="8"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Padding="4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−"
                                                        Width="28" Height="28"
                                                        FontSize="16"
                                                        Style="{StaticResource BtnGhost}"
                                                        Command="{Binding GiamCommand}"
                                                        PreviewMouseDoubleClick="BlockDoubleClick"/>
                                                <TextBlock Text="{Binding SoLuong}"
                                                           Width="28"
                                                           TextAlignment="Center"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"/>
                                                <Button Content="+"
                                                        Width="28" Height="28"
                                                        FontSize="16"
                                                        Style="{StaticResource BtnGhost}"
                                                        Command="{Binding TangCommand}"
                                                        PreviewMouseDoubleClick="BlockDoubleClick"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Giá -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="8,0"/>

                                        <!-- Xóa -->
                                        <Button Grid.Column="2"
                                                Content="🗑"
                                                Width="32" Height="32"
                                                Style="{StaticResource BtnIcon}"
                                                Background="{StaticResource DangerLightBrush}"
                                                Command="{Binding XoaCommand}"
                                                PreviewMouseDoubleClick="BlockDoubleClick"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Footer tổng + nút -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Background="{StaticResource BgMutedBrush}"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Tổng cộng"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Icon Quà Tặng - Áp Mã Giảm Giá -->
                    <Border Background="{StaticResource WarningLightBrush}"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            x:Name="GiftIconBorder"
                            MouseLeftButtonUp="ApDungMaGiamGia_Click"
                            MouseEnter="GiftIcon_MouseEnter"
                            MouseLeave="GiftIcon_MouseLeave">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🎁" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Áp dụng mã giảm giá"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🖨  In hóa đơn tạm"
                            Style="{StaticResource BtnSecondary}"
                            Height="42"
                            Margin="0,0,0,8"
                            Command="{Binding InHoaDonTamCommand}"/>

                    <Button Content="✅  Thanh toán"
                            Style="{StaticResource BtnPrimary}"
                            Height="46"
                            FontSize="15"
                            Command="{Binding MoThanhToanCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
