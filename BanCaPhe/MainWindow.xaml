<Window x:Class="BanCaPhe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:conv="clr-namespace:BanCaPhe.Converters"
        xmlns:local="clr-namespace:BanCaPhe.Models"
        Title="Bán cà phê"
        Height="600"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>
    
    <Grid Background="AntiqueWhite">

        <!-- CỘT -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= DANH MỤC ================= -->
        <Border Grid.Column="0"
        Margin="10"
        Background="White"
        CornerRadius="10"
        Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== PHẦN DANH MỤC ===== -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Danh mục đồ uống"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding DanhMuc}"
                     SelectedItem="{Binding SelectedDanhMuc}"
                     DisplayMemberPath="TenLoai">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Margin" Value="0,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="Danh mục đồ ăn kèm"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,15,0,10"/>

                    <TextBlock Text="Topping"
                       FontSize="18"
                       Cursor="Hand"
                       Margin="0,10,0,5"
                       MouseLeftButtonDown="Topping_Click"/>
                </StackPanel>

                <!-- ===== NÚT ĐĂNG XUẤT (CUỐI) ===== -->
                <Border Grid.Row="1"
                Margin="0,15,0,0"
                Padding="12"
                CornerRadius="10"
                Background="#FFF5F5"
                Cursor="Hand"
                MouseLeftButtonUp="Logout_Click"
                MouseEnter="Logout_MouseEnter"
                MouseLeave="Logout_MouseLeave"
                x:Name="LogoutBorder">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                        <TextBlock Text="⏻"
                           FontSize="22"
                           Foreground="#D32F2F"
                           Margin="0,0,8,0"/>

                        <TextBlock Text="ĐĂNG XUẤT"
                           FontWeight="Bold"
                           Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>


        <Border Grid.Column="1"
                Margin="10"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <StackPanel>
                <TextBlock Text="Sản phẩm"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DanhSachHienThi}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>


                        <ItemsControl.Resources>

                            <!-- TEMPLATE ĐỒ UỐNG -->
                            <DataTemplate DataType="{x:Type local:DoUong}">
                                <Border Width="150"
                    Height="200"
                    Margin="6"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1"
                   MouseLeftButtonDown="SanPham_Click">

                                    <StackPanel>
                                        <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                           Height="100"
                           Stretch="Uniform"
                           Margin="5"/>

                                        <TextBlock Text="{Binding TenDoUong}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                               Foreground="DarkRed"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- TEMPLATE TOPPING -->
                            <DataTemplate DataType="{x:Type local:Topping}">
                                <Border Width="150"
        Height="180"
        Margin="6"
        Background="#FFFDF6"
        CornerRadius="10"
        BorderBrush="#FFE0C080"
        BorderThickness="1"
        MouseLeftButtonDown="Toppingmua_Click">


                                    <StackPanel>
                                        <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                           Height="80"
                           Stretch="Uniform"
                           Margin="5"/>

                                        <TextBlock Text="{Binding TenTopping}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                                        <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                               Foreground="DarkGreen"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                                        <TextBlock Text="Topping"
                               FontSize="11"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                        </ItemsControl.Resources>

                    </ItemsControl>
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- ================= GIỎ HÀNG ================= -->
        <Border Grid.Column="2"
                Margin="10"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Đơn hàng"
                           FontSize="18"
                           FontWeight="Bold"/>

                <ListView Grid.Row="1"
          Margin="0,10"
          ItemsSource="{Binding DonHang}"
          SelectedItem="{Binding SelectedItem}"
          BorderThickness="0">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick"
                         Handler="ListViewItem_DoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>


                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                Padding="10"
                CornerRadius="10"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="1">

                                <StackPanel>

                                    <!-- ===== TÊN MÓN ===== -->
                                    <TextBlock FontWeight="Bold"
                           FontSize="14"
                           TextWrapping="Wrap">
                    <Run Text="{Binding Ten}" />
                    <Run Text=" (" />
                    <Run Text="{Binding Size}" />
                    <Run Text=")" />
                                    </TextBlock>

                                    <!-- ===== GHI CHÚ ===== -->
                                    <TextBlock Text="{Binding GhiChu}"
                           FontSize="12"
                           Foreground="#607D8B"
                           FontStyle="Italic"
                           Margin="0,2,0,0"/>

                                    <!-- ===== TOPPING ===== -->
                                    <ItemsControl ItemsSource="{Binding Toppings}"
                              Margin="15,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="• "
                                           FontSize="12"
                                           Foreground="#616161"/>
                                                    <TextBlock Text="{Binding Ten}"
                                           FontSize="12"
                                           Foreground="#616161"/>
                                                    <TextBlock Text=" x"/>
                                                    <TextBlock Text="{Binding SoLuong}"
                                           FontSize="12"
                                           Foreground="#616161"/>
                                                    <TextBlock Text=" ("/>
                                                    <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                           FontSize="12"
                                           Foreground="#616161"/>
                                                    <TextBlock Text=")"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                   
                                    <!-- ===== HÀNG DƯỚI ===== -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- SL + / - -->
                                        <Border Grid.Column="0"
                            CornerRadius="6"
                            BorderBrush="#BBDEFB"
                            BorderThickness="1"
                            Padding="4">
                                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                                                <Button Content="−"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Command="{Binding GiamCommand}"
                                    PreviewMouseDoubleClick="BlockDoubleClick"/>
                                                <TextBlock Text="{Binding SoLuong}"
                                       Width="28"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                                                <Button Content="+"
                                    Width="28"
                                    Height="28"
                                    FontSize="14"
                                    Command="{Binding TangCommand}"
                                    PreviewMouseDoubleClick="BlockDoubleClick"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- GIÁ (MÓN + TOPPING) -->
                                        <TextBlock Grid.Column="1"
                               Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                               Foreground="#D32F2F"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,10,0"/>

                                        <!-- XÓA -->
                                        <Button Grid.Column="2"
                            Content="🗑"
                            Width="36"
                            Height="36"
                            Background="#FFCDD2"
                            BorderBrush="#EF9A9A"
                            Command="{Binding XoaCommand}"
                            PreviewMouseDoubleClick="BlockDoubleClick"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>


                </ListView>

                <StackPanel Grid.Row="2">
                    <Separator/>
                    <TextBlock Text="{Binding TongTien, StringFormat=Tổng: {0:N0} đ}"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,5"/>

                    <Button Content="In hóa đơn tạm"
        Height="40"
        Background="#FF4CAF50"
        Foreground="White"
        Margin="0,5"
        Command="{Binding InHoaDonTamCommand}"/>

                    <Button Content="Thanh toán"
                            Height="40"
                            Background="#FF4CAF50"
                            Foreground="White"
                             Command="{Binding MoThanhToanCommand}"/>
                    
                    
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
