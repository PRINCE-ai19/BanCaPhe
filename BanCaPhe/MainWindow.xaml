<Window x:Class="BanCaPhe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        xmlns:models="clr-namespace:BanCaPhe.Models"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Bán cà phê"
        Height="650"
        Width="1150"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>
    
    <Grid Background="AntiqueWhite">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= DANH MỤC ================= -->
        <Border Grid.Column="0" Margin="10" Background="White" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Danh mục đồ uống" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding DanhMuc}"
                             SelectedItem="{Binding SelectedDanhMuc}"
                             DisplayMemberPath="TenLoai"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="Danh mục khác" FontSize="18" FontWeight="Bold" Margin="0,15,0,10"/>
                    <Border Background="#F5F5F5" CornerRadius="5" Padding="10" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding HienThiToppingCommand}"/>
                        </Border.InputBindings>
                        <TextBlock Text="Topping (Đồ thêm)" FontSize="16" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,15,0,0" Padding="12" CornerRadius="10" Background="#FFF5F5" Cursor="Hand" x:Name="LogoutBorder">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding LogoutCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏻" FontSize="20" Foreground="#D32F2F" Margin="0,0,8,0"/>
                        <TextBlock Text="ĐĂNG XUẤT" FontWeight="Bold" Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= SẢN PHẨM ================= -->
        <Border Grid.Column="1" Margin="10" Background="White" CornerRadius="10" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sản phẩm" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DanhSachHienThi}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.Resources>
                            <!-- TEMPLATE ĐỒ UỐNG -->
                            <DataTemplate DataType="{x:Type models:DoUong}">
                                <Border Width="160" Height="210" Margin="8" Background="White" CornerRadius="10" 
                                        BorderBrush="#DDD" BorderThickness="1" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ChonSanPhamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel Margin="5">
                                        <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" 
                                               Height="110" Stretch="Uniform" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding TenDoUong}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Height="40"/>
                                        <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}" Foreground="DarkRed" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- TEMPLATE TOPPING -->
                            <DataTemplate DataType="{x:Type models:Topping}">
                                <Border Width="160" Height="190" Margin="8" Background="#FFFDF6" CornerRadius="10" 
                                        BorderBrush="#FFE0C080" BorderThickness="1" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ChonToppingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel Margin="5">
                                        <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}" 
                                               Height="100" Stretch="Uniform" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding TenTopping}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}" Foreground="DarkGreen" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Topping" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= GIỎ HÀNG ================= -->
        <Border Grid.Column="2" Margin="10" Background="White" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Đơn hàng" FontSize="18" FontWeight="Bold"/>

                <ListView Grid.Row="1" Margin="0,10" ItemsSource="{Binding DonHang}" 
                          SelectedItem="{Binding SelectedItem}" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="5" Margin="0,2">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick" 
                                                              Command="{Binding DataContext.MoGhiChuCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Border.InputBindings>
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="8" BorderBrush="#90CAF9" BorderThickness="1" Background="White" Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                        <Run Text="{Binding Ten}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding Size}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding GhiChu}" FontSize="12" Foreground="#607D8B" FontStyle="Italic"/>

                                    <ItemsControl ItemsSource="{Binding Toppings}" Margin="10,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11" Foreground="#616161">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="• {0} x{1} ({2:N0} đ)">
                                                            <Binding Path="Ten"/>
                                                            <Binding Path="SoLuong"/>
                                                            <Binding Path="Gia"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Width="25" Command="{Binding GiamCommand}"/>
                                            <TextBlock Text="{Binding SoLuong}" Width="30" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="+" Width="25" Command="{Binding TangCommand}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding TongTien, StringFormat={}{0:N0} đ}" 
                                                   Foreground="#D32F2F" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>

                                        <Button Grid.Column="2" Content="🗑" Width="30" Background="#FFCDD2" Command="{Binding XoaCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Background="#FAFAFA" Margin="0,5,0,0">
                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10">
                        <StackPanel>
                             <TextBlock Text="{Binding TongTien, StringFormat=Tổng cộng: {0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,10"/>
                             <Button Content="IN HÓA ĐƠN TẠM" Height="35" Background="#81C784" Foreground="White" FontWeight="Bold" Command="{Binding InHoaDonTamCommand}" Margin="0,0,0,5"/>
                             <Button Content="THANH TOÁN" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" Command="{Binding MoThanhToanCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
