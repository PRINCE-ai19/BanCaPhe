<UserControl x:Class="BanCaPhe.UC_SanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR ── -->
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Quản lý Sản Phẩm"
                           Style="{StaticResource PageTitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="✏ Sửa"
                        Style="{StaticResource BtnSecondary}"
                        Margin="0,0,8,0"
                        Click="BtnSua_Click"/>
                <Button Content="🗑 Xóa"
                        Style="{StaticResource BtnDanger}"
                        Margin="0,0,8,0"
                        Click="BtnXoa_Click"/>
                <Button Content="＋  Thêm sản phẩm"
                        Style="{StaticResource BtnPrimary}"
                        Click="BtnThem_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── DATAGRID ── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource LightShadow}"
                Padding="0">
            <DataGrid x:Name="dgSanPham"
                      Style="{StaticResource ModtraDataGrid}"
                      RowStyle="{StaticResource ModtraDataGridRow}"
                      RowHeight="64"
                      ColumnHeaderStyle="{StaticResource ModtraColumnHeader}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Hình" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="48" Height="48"
                                        CornerRadius="10"
                                        Background="{StaticResource BgMutedBrush}"
                                        HorizontalAlignment="Center">
                                    <Image Width="44" Height="44"
                                           Stretch="Uniform"
                                           Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tên đồ uống"
                                        Binding="{Binding TenDoUong}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Giá (đ)"
                                        Binding="{Binding Gia, StringFormat={}{0:N0}}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Loại"
                                        Binding="{Binding TenLoai}"
                                        Width="150"/>
                    <DataGridCheckBoxColumn Header="Còn bán"
                                            Binding="{Binding ConBan}"
                                            Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
