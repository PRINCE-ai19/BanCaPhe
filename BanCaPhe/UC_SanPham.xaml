<UserControl x:Class="BanCaPhe.UC_SanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>



    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Thêm" Width="80" Margin="0,0,5,0"
                    Command="{Binding ThemCommand}"/>
            <Button Content="Sửa" Width="80" Margin="0,0,5,0"
                    Command="{Binding SuaCommand}"/>
            <Button Content="Xóa" Width="80"
                    Background="#E57373"
                    Command="{Binding XoaCommand}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dgSanPham"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding SanPhamList}"
                  SelectedItem="{Binding SelectedSanPham}"
                  RowHeight="70">

            <DataGrid.Columns>

                <!-- HÌNH ẢNH -->
                <DataGridTemplateColumn Header="Hình" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="60"
                           Height="60"
                           Stretch="UniformToFill"
                           Source="{Binding HinhAnh,
                                    Converter={StaticResource ImagePathConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Tên đồ uống"
                            Binding="{Binding TenDoUong}"
                            Width="*"/>

                <DataGridTextColumn Header="Giá"
                            Binding="{Binding Gia}"
                            Width="120"/>

                <DataGridTextColumn Header="Loại"
                            Binding="{Binding TenLoai}"
                            Width="150"/>

                <DataGridCheckBoxColumn Header="Còn bán"
                                Binding="{Binding ConBan}"
                                Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
