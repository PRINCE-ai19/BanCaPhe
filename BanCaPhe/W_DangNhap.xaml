<Window x:Class="BanCaPhe.W_DangNhap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:BanCaPhe"
    xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
    mc:Ignorable="d"
    Title="Đăng nhập"
    Height="437"
    Width="799"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#F2F3F5">

    <Window.DataContext>
        <vm:DangNhapViewModel/>
    </Window.DataContext>

    <Border Background="White"
        CornerRadius="12"
        Padding="25"
        Margin="20,20,20,20">

        <StackPanel>


            <TextBlock Text="ĐĂNG NHẬP TÀI KHOẢN"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>


            


            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                  Height="35"
                  Margin="0,5,0,10"/>


            <TextBlock Text="Mật khẩu"/>
            <PasswordBox x:Name="txtMatKhau"
                     Height="35"
                     Margin="0,5,0,10"/>


          

            <Button Content="Đăng Nhập"
                Height="40"
                Background="#6F4E37"
                Foreground="White"
                FontWeight="Bold"
                Command="{Binding DangNhapCommand}"
                CommandParameter="{Binding ElementName=txtMatKhau}"/>


            <TextBlock Text="Chưa có tài khoản? Đăng ký"
                    Foreground="#007ACC"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"
                    Cursor="Hand">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding MoDangKyCommand}"/>
                </TextBlock.InputBindings>
            </TextBlock>


            <TextBlock Text="Quên mật khẩu"
          Foreground="#007ACC"
          HorizontalAlignment="Center"
          Margin="0,15,0,0"
          Cursor="Hand"
          MouseDown="TextQuyenmatkhau_Click"/>

        </StackPanel>
    </Border>
</Window>
