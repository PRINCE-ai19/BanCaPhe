<Window x:Class="BanCaPhe.W_DangNhap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Đăng ký tài khoản"
    Height="437"
    Width="799"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#F2F3F5">

    <Border Background="White"
        CornerRadius="12"
        Padding="25"
        Margin="20,20,20,20">

        <StackPanel>


            <TextBlock Text="ĐĂNG NHẬP TÀI KHOẢN"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>


            


            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail"
                 Height="35"
                 Margin="0,5,0,10"/>


            <TextBlock Text="Mật khẩu"/>
            <PasswordBox x:Name="txtMatKhau"
                     Height="35"
                     Margin="0,5,0,10"/>


          

            <Button Content="Đăng Nhập"
                Height="40"
                Background="#6F4E37"
                Foreground="White"
                FontWeight="Bold"
                Click="BtnDangNhap_Click"/>


            <TextBlock Text="Chưa có tài khoản? Đăng ký"
                   Foreground="#007ACC"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"
                   Cursor="Hand"
                   MouseDown="TextDagKy_Click"/>


            <TextBlock Text="Quên mật khẩu"
          Foreground="#007ACC"
          HorizontalAlignment="Center"
          Margin="0,15,0,0"
          Cursor="Hand"
          MouseDown="TextQuyenmatkhau_Click"/>

        </StackPanel>
    </Border>
</Window>
