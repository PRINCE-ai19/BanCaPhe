<Window x:Class="BanCaPhe.W_DangNhap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:BanCaPhe"
    xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
    xmlns:conv="clr-namespace:BanCaPhe.Converters"
    mc:Ignorable="d"
    Title="Modtra - Đăng nhập"
    Height="550"
    Width="1100"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#FAFAF8">

    <Window.DataContext>
        <vm:DangNhapViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- BÊN TRÁI - HÌNH COFFEE & WELCOME -->
        <Border Grid.Column="0" Background="#A8D5BA" Padding="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- HÌNH COFFEE -->
                <Border Width="280" Height="280" Background="#FFFFFF" CornerRadius="20" Padding="12" Margin="0,0,0,30" BorderBrush="#D0E8DC" BorderThickness="2">
                    <Image Source="HinhAnh/cafe_sua_da.png" 
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                
                <!-- TEXT WELCOME -->
                <TextBlock Text="🍵 MODTRA" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>
                
                <TextBlock Text="Matcha &amp; Cà phê chất lượng cao" 
                           FontSize="16" 
                           Foreground="#FFFFFF" 
                           TextAlignment="Center"
                           Opacity="0.95"
                           Margin="0,0,0,20"/>
                
                <TextBlock Text="Quản lý bán hàng chuyên nghiệp" 
                           FontSize="13" 
                           Foreground="#FFFFFF" 
                           TextAlignment="Center"
                           Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- BÊN PHẢI - FORM ĐĂNG NHẬP -->
        <Border Grid.Column="1" Background="#FFFFFF" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Padding="50,40,50,40">
                    <StackPanel VerticalAlignment="Center">
                        <!-- TIÊU ĐỀ -->
                        <TextBlock Text="Đăng nhập" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                               Foreground="#2D5F3F"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Nhập thông tin tài khoản của bạn" 
                               FontSize="13" 
                               Foreground="#6B8B7E"
                               Margin="0,0,0,32"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtEmail"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="44"
                             Margin="0,0,0,20"
                             Padding="14,12"
                             FontSize="13"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#E0F0E8"
                             BorderThickness="1"/>

                    <!-- MẬT KHẨU -->
                    <TextBlock Text="Mật khẩu" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,8"/>
                    <PasswordBox x:Name="txtMatKhau"
                                 Height="44"
                                 Margin="0,0,0,28"
                                 Padding="14,12"
                                 FontSize="13"
                                 Background="#F1F8F4"
                                 BorderBrush="#E0F0E8"
                                 BorderThickness="1"/>

                    <!-- NÚT ĐĂNG NHẬP -->
                    <Button Content="Đăng nhập"
                            Height="48"
                            FontSize="14"
                            FontWeight="Bold"
                            Margin="0,0,0,20"
                            Command="{Binding DangNhapCommand}"
                            CommandParameter="{Binding ElementName=txtMatKhau}"
                            Background="#A8D5BA"
                            Foreground="#FFFFFF"
                            BorderThickness="0"/>

                    <!-- LIÊN KẾT ĐĂNG KÝ -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="Chưa có tài khoản? " 
                                   Foreground="#6B8B7E"
                                   FontSize="12"/>
                        <TextBlock Text="Đăng ký ngay" 
                                   Foreground="#A8D5BA"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding MoDangKyCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <!-- QUÊN MẬT KHẨU -->
                    <TextBlock Text="Quên mật khẩu?" 
                               Foreground="#A8D5BA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Cursor="Hand"
                               MouseDown="TextQuyenmatkhau_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
