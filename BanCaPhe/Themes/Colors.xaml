<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== PRIMARY COLORS ==================== -->
    <Color x:Key="PrimaryColor">#0058BE</Color>
    <Color x:Key="PrimaryContainerColor">#2170E4</Color>
    <Color x:Key="PrimaryFixedColor">#D8E2FF</Color>
    <Color x:Key="PrimaryFixedDimColor">#ADC6FF</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnPrimaryContainerColor">#FEFCFF</Color>
    <Color x:Key="OnPrimaryFixedColor">#001A42</Color>
    <Color x:Key="OnPrimaryFixedVariantColor">#004395</Color>

    <!-- ==================== SECONDARY COLORS ==================== -->
    <Color x:Key="SecondaryColor">#5C5F60</Color>
    <Color x:Key="SecondaryContainerColor">#DEE0E2</Color>
    <Color x:Key="SecondaryFixedColor">#E1E2E4</Color>
    <Color x:Key="SecondaryFixedDimColor">#C5C6C8</Color>
    <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
    <Color x:Key="OnSecondaryContainerColor">#606365</Color>
    <Color x:Key="OnSecondaryFixedColor">#191C1E</Color>
    <Color x:Key="OnSecondaryFixedVariantColor">#444749</Color>

    <!-- ==================== TERTIARY COLORS (SUCCESS) ==================== -->
    <Color x:Key="TertiaryColor">#006947</Color>
    <Color x:Key="TertiaryContainerColor">#00855B</Color>
    <Color x:Key="TertiaryFixedColor">#6FFBBE</Color>
    <Color x:Key="TertiaryFixedDimColor">#4EDEA3</Color>
    <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
    <Color x:Key="OnTertiaryContainerColor">#F5FFF6</Color>
    <Color x:Key="OnTertiaryFixedColor">#002113</Color>
    <Color x:Key="OnTertiaryFixedVariantColor">#005236</Color>

    <!-- ==================== ERROR COLORS ==================== -->
    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="ErrorContainerColor">#FFDAD6</Color>
    <Color x:Key="OnErrorColor">#FFFFFF</Color>
    <Color x:Key="OnErrorContainerColor">#93000A</Color>

    <!-- ==================== SURFACE COLORS ==================== -->
    <Color x:Key="SurfaceColor">#F9F9F9</Color>
    <Color x:Key="SurfaceBrightColor">#F9F9F9</Color>
    <Color x:Key="SurfaceDimColor">#DADADA</Color>
    <Color x:Key="SurfaceContainerLowestColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowColor">#F3F3F4</Color>
    <Color x:Key="SurfaceContainerColor">#EEEEEE</Color>
    <Color x:Key="SurfaceContainerHighColor">#E8E8E8</Color>
    <Color x:Key="SurfaceContainerHighestColor">#E2E2E2</Color>
    <Color x:Key="SurfaceVariantColor">#E2E2E2</Color>
    <Color x:Key="OnSurfaceColor">#1A1C1C</Color>
    <Color x:Key="OnSurfaceVariantColor">#424754</Color>

    <!-- ==================== OUTLINE COLORS ==================== -->
    <Color x:Key="OutlineColor">#727785</Color>
    <Color x:Key="OutlineVariantColor">#C2C6D6</Color>

    <!-- ==================== BACKGROUND ==================== -->
    <Color x:Key="BackgroundColor">#F9F9F9</Color>
    <Color x:Key="InverseSurfaceColor">#2F3131</Color>
    <Color x:Key="InverseOnSurfaceColor">#F0F1F1</Color>
    <Color x:Key="InversePrimaryColor">#ADC6FF</Color>
    <Color x:Key="SurfaceTintColor">#005AC2</Color>

</ResourceDictionary>
