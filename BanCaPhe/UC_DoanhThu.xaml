<UserControl x:Class="BanCaPhe.UC_DoanhThu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:RowNumberConverter x:Key="RowNumberConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:DoanhThuViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ── HEADER ── -->
            <Grid Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊  Báo cáo Doanh Thu"
                               Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding ThangNamHienTai}"
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom"
                               Margin="12,0,0,2"/>
                </StackPanel>
                <Button Content="🔄  Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Height="40"
                        Padding="16,0"
                        HorizontalAlignment="Right"/>
            </Grid>

            <!-- ── STAT CARDS ── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng doanh thu -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}"
                        Background="{StaticResource SuccessLightBrush}">
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="TỔNG DOANH THU"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TongDoanhThuDisplay}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Tổng đơn hàng -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}"
                        Background="{StaticResource InfoLightBrush}">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="TỔNG ĐƠN HÀNG"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TongDonHang}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Đơn TB -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}"
                        Background="{StaticResource WarningLightBrush}">
                    <StackPanel>
                        <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="ĐƠN TRUNG BÌNH"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding DoanhThuTrungBinhDisplay}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Đơn lớn nhất -->
                <Border Grid.Column="3" Style="{StaticResource StatCard}"
                        Background="{StaticResource DangerLightBrush}">
                    <StackPanel>
                        <TextBlock Text="🏆" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="ĐƠN LỚN NHẤT"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding DonHangLonNhatDisplay}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 2 PANEL: SP BÁN CHẠY + TOPPING PHỔ BIẾN ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sản phẩm bán chạy -->
                <Border Grid.Column="0"
                        Background="White" CornerRadius="14"
                        Margin="0,0,10,0" Padding="20"
                        Effect="{StaticResource LightShadow}">
                    <StackPanel>
                        <TextBlock Text="🔥  Sản phẩm bán chạy nhất"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,0,0,16"/>
                        <DataGrid ItemsSource="{Binding SanPhamBanChay}"
                                  Style="{StaticResource ModtraDataGrid}"
                                  RowStyle="{StaticResource ModtraDataGridRow}"
                                  ColumnHeaderStyle="{StaticResource ModtraColumnHeader}"
                                  Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="40"
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                              Converter={StaticResource RowNumberConverter}}"/>
                                <DataGridTextColumn Header="Tên sản phẩm"
                                                    Binding="{Binding TenHienThi}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="SL"
                                                    Binding="{Binding TongSoLuongBan}"
                                                    Width="60"/>
                                <DataGridTextColumn Header="Doanh thu"
                                                    Binding="{Binding DoanhThuDisplay}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Topping phổ biến -->
                <Border Grid.Column="1"
                        Background="White" CornerRadius="14"
                        Padding="20"
                        Effect="{StaticResource LightShadow}">
                    <StackPanel>
                        <TextBlock Text="🌟  Topping phổ biến"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        <ListView ItemsSource="{Binding ToppingPhoBien}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Height="300">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgMutedBrush}"
                                            CornerRadius="10"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding TenTopping}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Margin="0,6,0,0">
                                                <Border Background="{StaticResource SuccessLightBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TongSoLuong, StringFormat='SL: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{StaticResource WarningLightBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,3">
                                                    <TextBlock Text="{Binding DoanhThuDisplay}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading indicator -->
            <Border Background="#CC1E2D2B"
                    CornerRadius="12"
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="White" FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
