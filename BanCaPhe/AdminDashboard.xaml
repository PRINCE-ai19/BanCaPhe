<Window x:Class="BanCaPhe.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Modtra — Quản lý"
        Height="680"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}">

    <Window.DataContext>
        <vm:AdminDashboardViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Bảng điều khiển"
                           Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Chào mừng trở lại, Admin ☀️"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── STAT CARDS ── -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,20">

            <!-- Doanh thu -->
            <Border Style="{StaticResource StatCard}"
                    MouseLeftButtonUp="DoanhThu_Click">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="26" Margin="0,0,0,8"/>
                    <TextBlock Text="DOANH THU"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding DoanhThuDisplay}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Sản phẩm -->
            <Border Style="{StaticResource StatCard}"
                    MouseLeftButtonUp="SanPham_Click">
                <StackPanel>
                    <TextBlock Text="🥤" FontSize="26" Margin="0,0,0,8"/>
                    <TextBlock Text="SẢN PHẨM"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding SoLuongSanPham}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource InfoBrush}"/>
                </StackPanel>
            </Border>

            <!-- Loại SP -->
            <Border Style="{StaticResource StatCard}"
                    MouseLeftButtonUp="LoaiSanPham_Click">
                <StackPanel>
                    <TextBlock Text="📂" FontSize="26" Margin="0,0,0,8"/>
                    <TextBlock Text="LOẠI SP"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding SoLuongLoaiSanPham}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Topping -->
            <Border Style="{StaticResource StatCard}"
                    MouseLeftButtonUp="Topping_Click">
                <StackPanel>
                    <TextBlock Text="🧋" FontSize="26" Margin="0,0,0,8"/>
                    <TextBlock Text="TOPPING"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding SoLuongTopping}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>

            <!-- Nhân viên -->
            <Border Style="{StaticResource StatCard}"
                    MouseLeftButtonUp="NhanVien_Click">
                <StackPanel>
                    <TextBlock Text="👨‍💼" FontSize="26" Margin="0,0,0,8"/>
                    <TextBlock Text="NHÂN VIÊN"
                               Style="{StaticResource FormLabel}"/>
                    <TextBlock Text="{Binding SoLuongNhanVien}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Đăng xuất -->
            <Border x:Name="LogoutCard"
                    Style="{StaticResource StatCard}"
                    Background="{StaticResource DangerLightBrush}"
                    MouseLeftButtonUp="Logout_Click"
                    MouseEnter="Logout_MouseEnter"
                    MouseLeave="Logout_MouseLeave">
                <StackPanel>
                    <TextBlock Text="⏻" FontSize="26"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="ĐĂNG XUẤT"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"/>
                    <TextBlock Text="Thoát hệ thống"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── CONTENT AREA ── -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="0">
            <ContentControl x:Name="AdimMainContent"/>
        </Border>
    </Grid>
</Window>
