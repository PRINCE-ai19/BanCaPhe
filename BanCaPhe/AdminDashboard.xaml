<Window x:Class="BanCaPhe.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        Title="Trang Quản lý"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F2F3F5">

    <Window.DataContext>
        <vm:AdminDashboardViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,20">
            <!-- Doanh thu -->
            <Border Background="White" CornerRadius="12" Margin="10" Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="DoanhThu"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="DOANH THU" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="{Binding DoanhThuDisplay}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#2ECC71"/>
                </StackPanel>
            </Border>

            <!-- Sản phẩm -->
            <Border Background="White" CornerRadius="12" Margin="10" Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="SanPham"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="SẢN PHẨM" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="{Binding SoLuongSanPham}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#3498DB"/>
                </StackPanel>
            </Border>

            <!-- Loại sản phẩm -->
            <Border Background="White" CornerRadius="12" Margin="10" Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="LoaiSanPham"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="LOẠI SẢN PHẨM" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="{Binding SoLuongLoaiSanPham}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#9B59B6"/>
                </StackPanel>
            </Border>

            <!-- Topping -->
            <Border Background="White" CornerRadius="12" Margin="10" Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="Topping"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="TOPPING" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="{Binding SoLuongTopping}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#E67E22"/>
                </StackPanel>
            </Border>

            <!-- Nhân viên -->
            <Border Background="White" CornerRadius="12" Margin="10" Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="NhanVien"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="NHÂN VIÊN" FontWeight="Bold" Foreground="#666"/>
                    <TextBlock Text="{Binding SoLuongNhanVien}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#E74C3C"/>
                </StackPanel>
            </Border>

            <!-- Đăng xuất -->
            <Border x:Name="LogoutCard"
                    Background="#FFF5F5"
                    CornerRadius="12"
                    Margin="10"
                    Padding="15"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding LogoutCommand}"/>
                </Border.InputBindings>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon -->
                    <TextBlock Text="⏻"
                               FontSize="26"
                               Foreground="#FF4D4F"
                               Margin="0,0,10,0"/>
                    <!-- Text -->
                    <StackPanel>
                        <TextBlock Text="ĐĂNG XUẤT"
                                   FontWeight="Bold"
                                   Foreground="#FF4D4F"/>
                        <TextBlock Text="Thoát khỏi hệ thống"
                                   FontSize="12"
                                   Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15">
            <ContentControl Content="{Binding CurrentContent}"/>
        </Border>
    </Grid>
</Window>
