<UserControl x:Class="BanCaPhe.UC_AdminTopping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Quản lý Topping"
                       Style="{StaticResource PageTitle}"/>
            <Button Content="＋  Thêm topping"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right"
                    Click="BtnThem_Click"/>
        </Grid>

        <!-- ── DATAGRID ── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource LightShadow}">
            <DataGrid x:Name="dgTopping"
                      Style="{StaticResource ModtraDataGrid}"
                      RowStyle="{StaticResource ModtraDataGridRow}"
                      RowHeight="60"
                      ColumnHeaderStyle="{StaticResource ModtraColumnHeader}">
                <DataGrid.Columns>
                    <!-- ẢNH -->
                    <DataGridTemplateColumn Header="Ảnh" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="44" Height="44"
                                        CornerRadius="22"
                                        Background="{StaticResource BgMutedBrush}"
                                        HorizontalAlignment="Center"
                                        ClipToBounds="True">
                                    <Image Source="{Binding HinhAnh}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tên topping"
                                        Binding="{Binding TenTopping}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Giá (đ)"
                                        Binding="{Binding Gia, StringFormat={}{0:N0}}"
                                        Width="110"/>
                    <DataGridCheckBoxColumn Header="Bán riêng"
                                            Binding="{Binding CoTheBanRieng}"
                                            Width="90"/>
                    <DataGridCheckBoxColumn Header="Còn bán"
                                            Binding="{Binding ConBan}"
                                            Width="80"/>

                    <!-- THAO TÁC -->
                    <DataGridTemplateColumn Header="Thao tác" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="✏ Sửa"
                                            Style="{StaticResource BtnGhost}"
                                            Margin="0,0,6,0"
                                            Click="BtnSua_Click"/>
                                    <Button Content="🗑"
                                            Style="{StaticResource BtnIcon}"
                                            Background="{StaticResource DangerLightBrush}"
                                            Foreground="{StaticResource DangerBrush}"
                                            Click="BtnXoa_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
