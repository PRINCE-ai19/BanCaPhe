<UserControl x:Class="BanCaPhe.UC_AdminTopping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
             Height="Auto" Width="Auto">

    <UserControl.DataContext>
        <vm:ToppingViewModel/>
    </UserControl.DataContext>

    <Grid Margin="0" Background="#FAFAF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#2D5F3F" Padding="20,12,20,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍯 Quản lý topping"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DanhSachTopping.Count, StringFormat=({0} topping)}"
                               FontSize="12"
                               Foreground="#D0E8DC"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- ADD BUTTON -->
                <Button Grid.Column="1"
                        Content="+ Thêm topping"
                        Height="36"
                        Padding="16,8"
                        Background="#A8D5BA"
                        Foreground="#1F4D3D"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ThemCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgTopping"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="60"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhSachTopping}"
                  SelectedItem="{Binding SelectedTopping}"
                  Background="#FFFFFF"
                  Foreground="#1F4D3D"
                  BorderBrush="#D0E8DC"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E8F0E8"
                  Margin="0">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8F0E8"/>
                    <Setter Property="Foreground" Value="#2D5F3F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderBrush" Value="#D0E8DC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- ẢNH -->
                <DataGridTemplateColumn Header="Ảnh" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="45"
                                    Height="45"
                                    CornerRadius="22.5"
                                    BorderBrush="#D0E8DC"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FFF9E6">
                                <Image Source="{Binding HinhAnh}"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TÊN -->
                <DataGridTextColumn Header="Tên topping"
                                    Binding="{Binding TenTopping}"
                                    Width="*"/>

                <!-- GIÁ -->
                <DataGridTextColumn Header="Giá"
                                    Binding="{Binding Gia, StringFormat={}{0:N0} đ}"
                                    Width="120"/>

                <!-- BÁN RIÊNG -->
                <DataGridCheckBoxColumn Header="Bán riêng"
                                        Binding="{Binding CoTheBanRieng}"
                                        Width="100"/>

                <!-- CÒN BÁN -->
                <DataGridCheckBoxColumn Header="Còn bán"
                                        Binding="{Binding ConBan}"
                                        Width="90"/>

                <!-- THAO TÁC -->
                <DataGridTemplateColumn Header="Thao tác" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="4">

                                <!-- NÚT THÊM -->
                                <Button Content="+ Thêm"
                                        Width="60"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Background="#2D7A5C"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ThemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- NÚT SỬA -->
                                <Button Content="✎ Sửa"
                                        Width="80"
                                        Height="36"
                                        Margin="0,0,4,0"
                                        Background="#A8D5BA"
                                        Foreground="#1F4D3D"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- NÚT XÓA -->
                                <Button Content="✕ Xóa"
                                        Width="80"
                                        Height="36"
                                        Background="#FFCDD2"
                                        Foreground="#C62828"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
