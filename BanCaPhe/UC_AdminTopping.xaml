<UserControl x:Class="BanCaPhe.UC_AdminTopping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Quản lý Topping"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <Button Content="+ Thêm topping"
                    Width="140"
                    DockPanel.Dock="Right"
                    Click="BtnThem_Click"/>
        </DockPanel>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgTopping"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="60"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <!-- ẢNH -->
                <DataGridTemplateColumn Header="Ảnh" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="45"
                                    Height="45"
                                    CornerRadius="22.5"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding HinhAnh}"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TÊN -->
                <DataGridTextColumn Header="Tên topping"
                                    Binding="{Binding TenTopping}"
                                    Width="*"/>

                <!-- GIÁ -->
                <DataGridTextColumn Header="Giá"
                                    Binding="{Binding Gia, StringFormat={}{0:N0}}"
                                    Width="120"/>

                <!-- BÁN RIÊNG -->
                <DataGridCheckBoxColumn Header="Bán riêng"
                                        Binding="{Binding CoTheBanRieng}"
                                        Width="100"/>

                <!-- CÒN BÁN -->
                <DataGridCheckBoxColumn Header="Còn bán"
                                        Binding="{Binding ConBan}"
                                        Width="90"/>

                <!-- ACTION -->
                <DataGridTemplateColumn Header="Thao tác" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="Sửa"
                                        Width="60"
                                        Margin="0,0,5,0"
                                        Click="BtnSua_Click"/>

                                <Button Content="Xóa"
                                        Width="60"
                                        Background="#E74C3C"
                                        Foreground="White"
                                        Click="BtnXoa_Click"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
