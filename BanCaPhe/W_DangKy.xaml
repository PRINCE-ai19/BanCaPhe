<Window x:Class="BanCaPhe.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BanCaPhe"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        mc:Ignorable="d"
        Title="Đăng ký tài khoản"
        Height="635"
        Width="799"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F3F5">

    <Window.DataContext>
        <vm:DangKyViewModel/>
    </Window.DataContext>

    <Border Background="White"
            CornerRadius="12"
            Padding="25"
            Margin="20">

        <StackPanel>

        
            <TextBlock Text="ĐĂNG KÝ TÀI KHOẢN"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

          
            <TextBlock Text="Họ tên"/>
            <TextBox x:Name="txtHoTen"
                     Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"
                     Height="35"
                     Margin="0,5,0,10"/>

           
            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Height="35"
                     Margin="0,5,0,10"/>

          
            <TextBlock Text="Mật khẩu"/>
            <PasswordBox x:Name="txtMatKhau"
                         Height="35"
                         Margin="0,5,0,10"/>

        
            <TextBlock Text="Xác nhận mật khẩu"/>
            <PasswordBox x:Name="txtXacNhan"
                         Height="35"
                         Margin="0,5,0,10"/>

         
            <TextBlock Text="Số điện thoại"/>
            <TextBox x:Name="txtSoDienThoai"
                     Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                     Height="35"
                     Margin="0,5,0,20"/>

      
            <Button Content="Đăng ký"
                    Height="40"
                    Background="#6F4E37"
                    Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding DangKyCommand}"
                    CommandParameter="{Binding ElementName=txtMatKhau}"/>

      
            <TextBlock Text="Đã có tài khoản? Đăng nhập"
                       Foreground="#007ACC"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       Cursor="Hand">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding QuayLaiCommand}"/>
                </TextBlock.InputBindings>
            </TextBlock>

        </StackPanel>
    </Border>
</Window>
