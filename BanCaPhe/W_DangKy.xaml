<Window x:Class="BanCaPhe.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BanCaPhe"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        mc:Ignorable="d"
        Title="Modtra - Đăng ký"
        Height="580"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAF8">

    <Window.DataContext>
        <vm:DangKyViewModel/>
    </Window.DataContext>

    <Border Background="#FFFFFF" CornerRadius="16" Padding="0" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#2D5F3F" Padding="20,16,20,16" CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BACK BUTTON -->
                    <Button Grid.Column="0"
                            Content="← Quay lại"
                            Width="Auto"
                            Height="32"
                            Padding="12,6"
                            Background="Transparent"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="11"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding QuayLaiCommand}"/>

                    <!-- TITLE -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Tạo tài khoản mới" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#FFFFFF"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- SPACER -->
                    <TextBlock Grid.Column="2" Width="80"/>
                </Grid>
            </Border>

            <!-- FORM -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20">
                <StackPanel>
                    <!-- HỌ TÊN -->
                    <TextBlock Text="Họ tên" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtHoTen"
                             Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Margin="0,0,0,14"
                             Padding="12,9"
                             FontSize="12"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#E0F0E8"
                             BorderThickness="1"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtEmail"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Margin="0,0,0,14"
                             Padding="12,9"
                             FontSize="12"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#E0F0E8"
                             BorderThickness="1"/>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <TextBlock Text="Số điện thoại" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtSoDienThoai"
                             Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Margin="0,0,0,14"
                             Padding="12,9"
                             FontSize="12"
                             Background="#F1F8F4"
                             Foreground="#2D5F3F"
                             BorderBrush="#E0F0E8"
                             BorderThickness="1"/>

                    <!-- MẬT KHẨU -->
                    <TextBlock Text="Mật khẩu" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtMatKhau"
                                 Height="36"
                                 Margin="0,0,0,14"
                                 Padding="12,9"
                                 FontSize="12"
                                 Background="#F1F8F4"
                                 BorderBrush="#E0F0E8"
                                 BorderThickness="1"/>

                    <!-- XÁC NHẬN MẬT KHẨU -->
                    <TextBlock Text="Xác nhận mật khẩu" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#2D5F3F"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtXacNhan"
                                 Height="36"
                                 Margin="0,0,0,16"
                                 Padding="12,9"
                                 FontSize="12"
                                 Background="#F1F8F4"
                                 BorderBrush="#E0F0E8"
                                 BorderThickness="1"/>

                    <!-- NÚT ĐĂNG KÝ -->
                    <Button Content="Đăng ký"
                            Height="40"
                            Background="#2D7A5C"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            FontSize="12"
                            Command="{Binding DangKyCommand}"
                            CommandParameter="{Binding ElementName=txtMatKhau}"
                            Margin="0,0,0,12"
                            BorderThickness="0"/>

                    <!-- LIÊN KẾT ĐĂNG NHẬP -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Đã có tài khoản? " 
                                   Foreground="#6B8B7E"
                                   FontSize="11"/>
                        <TextBlock Text="Đăng nhập"
                                   Foreground="#2D7A5C"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding QuayLaiCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
