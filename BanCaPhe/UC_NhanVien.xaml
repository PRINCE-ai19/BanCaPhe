<UserControl x:Class="BanCaPhe.UC_NhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:conv="clr-namespace:BanCaPhe.Converters"
              xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
              Height="Auto"
              Width="Auto">

    <UserControl.DataContext>
        <vm:NhanVienViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Quản lý nhân viên"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <Button Content="+ Thêm nhân viên"
                    Width="140"
                    DockPanel.Dock="Right"
                    Command="{Binding ThemCommand}"/>
        </DockPanel>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgNhanVien"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="60"
                  SelectionMode="Single"
                  ItemsSource="{Binding ListNhanVien}"
                  SelectedItem="{Binding SelectedNhanVien}">

            <DataGrid.Columns>

                <!-- ẢNH -->
                <DataGridTemplateColumn Header="Ảnh" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="50"
                    Height="50"
                    CornerRadius="25"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                                <Image Stretch="UniformToFill"
                       Source="{Binding HinhAnh,
                       Converter={StaticResource ImagePathConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- HỌ TÊN -->
                <DataGridTextColumn Header="Họ tên"
                                    Binding="{Binding HoTen}"
                                    Width="*"/>

                <!-- EMAIL -->
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="*"/>

                <!-- SĐT -->
                <DataGridTextColumn Header="SĐT"
                                    Binding="{Binding SoDienThoai}"
                                    Width="120"/>

                <!-- VAI TRÒ -->
                <DataGridTextColumn Header="Vai trò"
                                    Binding="{Binding VaiTro}"
                                    Width="100"/>

                <!-- TRẠNG THÁI -->
                <DataGridCheckBoxColumn Header="Hoạt động"
                                        Binding="{Binding TrangThai}"
                                        Width="90"/>

                <!-- THAO TÁC -->
                <DataGridTemplateColumn Header="Thao tác" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                <!-- NÚT SỬA -->
                                <Button Content="Sửa"
                        Width="60"
                        Margin="0,0,5,0"
                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                <!-- NÚT XÓA -->
                                <Button Content="Xóa"
                        Width="60"
                        Margin="0,0,5,0"
                        Background="#E74C3C"
                        Foreground="White"
                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                                <!-- (TUỲ CHỌN) NÚT ĐỔI MẬT KHẨU -->
                                <Button Content="Đổi MK"
                        Width="70"
                        Command="{Binding DataContext.DoiMatKhauCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
