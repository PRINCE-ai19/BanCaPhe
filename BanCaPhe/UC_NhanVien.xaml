<UserControl x:Class="BanCaPhe.UC_NhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Grid Margin="0,0,0,16">
            <TextBlock Text="Quản lý Nhân Viên"
                       Style="{StaticResource PageTitle}"/>
            <Button Content="＋  Thêm nhân viên"
                    Style="{StaticResource BtnPrimary}"
                    HorizontalAlignment="Right"
                    Click="BtnThem_Click"/>
        </Grid>

        <!-- ── DATAGRID ── -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Effect="{StaticResource LightShadow}">
            <DataGrid x:Name="dgNhanVien"
                      Style="{StaticResource ModtraDataGrid}"
                      RowStyle="{StaticResource ModtraDataGridRow}"
                      RowHeight="62"
                      ColumnHeaderStyle="{StaticResource ModtraColumnHeader}">
                <DataGrid.Columns>

                    <!-- ẢNH đại diện -->
                    <DataGridTemplateColumn Header="Ảnh" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="46" Height="46"
                                        CornerRadius="23"
                                        Background="{StaticResource BgMutedBrush}"
                                        HorizontalAlignment="Center"
                                        ClipToBounds="True">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="*"/>
                    <DataGridTextColumn Header="SĐT"
                                        Binding="{Binding SoDienThoai}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Vai trò"
                                        Binding="{Binding VaiTro}"
                                        Width="90"/>
                    <DataGridCheckBoxColumn Header="Hoạt động"
                                            Binding="{Binding TrangThai}"
                                            Width="80"/>

                    <!-- THAO TÁC -->
                    <DataGridTemplateColumn Header="Thao tác" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Content="✏ Sửa"
                                            Style="{StaticResource BtnGhost}"
                                            Margin="0,0,4,0"
                                            Click="BtnSua_Click"/>
                                    <Button Content="🗑"
                                            Style="{StaticResource BtnIcon}"
                                            Background="{StaticResource DangerLightBrush}"
                                            Foreground="{StaticResource DangerBrush}"
                                            Margin="0,0,4,0"
                                            Click="BtnXoa_Click"/>
                                    <Button Content="🔑 MK"
                                            Style="{StaticResource BtnGhost}"
                                            Click="BtnDoiMatKhau_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
