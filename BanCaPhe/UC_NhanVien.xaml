<UserControl x:Class="BanCaPhe.UC_NhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:conv="clr-namespace:BanCaPhe.Converters"
              xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
              Height="Auto"
              Width="Auto">

    <UserControl.DataContext>
        <vm:NhanVienViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>


    <Grid Margin="0" Background="#FAFAF8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#2D5F3F" Padding="20,12,20,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 Quản lý nhân viên"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ListNhanVien.Count, StringFormat=({0} nhân viên)}"
                               FontSize="12"
                               Foreground="#D0E8DC"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- ADD BUTTON -->
                <Button Grid.Column="1"
                        Content="+ Thêm nhân viên"
                        Height="36"
                        Padding="16,8"
                        Background="#A8D5BA"
                        Foreground="#1F4D3D"
                        FontWeight="Bold"
                        FontSize="12"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ThemCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgNhanVien"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  RowHeight="60"
                  SelectionMode="Single"
                  ItemsSource="{Binding ListNhanVien}"
                  SelectedItem="{Binding SelectedNhanVien}"
                  Background="#FFFFFF"
                  Foreground="#1F4D3D"
                  BorderBrush="#D0E8DC"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E8F0E8"
                  Margin="0">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8F0E8"/>
                    <Setter Property="Foreground" Value="#2D5F3F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderBrush" Value="#D0E8DC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- ẢNH -->
                <DataGridTemplateColumn Header="Ảnh" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="50"
                                    Height="50"
                                    CornerRadius="25"
                                    BorderBrush="#D0E8DC"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F1F8F4">
                                <Image Stretch="UniformToFill"
                                       Source="{Binding HinhAnh,
                                       Converter={StaticResource ImagePathConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- HỌ TÊN -->
                <DataGridTextColumn Header="Họ tên"
                                    Binding="{Binding HoTen}"
                                    Width="*"/>

                <!-- EMAIL -->
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="180"/>

                <!-- SĐT -->
                <DataGridTextColumn Header="SĐT"
                                    Binding="{Binding SoDienThoai}"
                                    Width="120"/>

                <!-- VAI TRÒ -->
                <DataGridTextColumn Header="Vai trò"
                                    Binding="{Binding VaiTro}"
                                    Width="100"/>

                <!-- TRẠNG THÁI -->
                <DataGridCheckBoxColumn Header="Hoạt động"
                                        Binding="{Binding TrangThai}"
                                        Width="90"/>

                <!-- THAO TÁC -->
                <DataGridTemplateColumn Header="Thao tác" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="4">

                                <!-- NÚT THÊM -->
                                <Button Content="+ Thêm"
                                        Width="60"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Background="#2D7A5C"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ThemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- NÚT SỬA -->
                                <Button Content="✎ Sửa"
                                        Width="60"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Background="#A8D5BA"
                                        Foreground="#1F4D3D"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- NÚT XÓA -->
                                <Button Content="✕ Xóa"
                                        Width="60"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Background="#FFCDD2"
                                        Foreground="#C62828"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- NÚT ĐỔI MẬT KHẨU -->
                                <Button Content="🔑 MK"
                                        Width="60"
                                        Height="32"
                                        Background="#2D7A5C"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.DoiMatKhauCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
